---
// The "Logbook" app tab: the personal jump ledger (add/edit/delete, with
// an expandable detail row per jump) plus the saved Places / Equipment /
// Aircraft / Jump types profiles its form's dropdowns pick from, and the
// "jumps logged before this app" starting-number setting. Each of those
// pieces is its own component under tabs/logbook/ — this file just lays
// them out and owns the props they're built from.
import type { NumberedEntry } from '../../lib/logbook';
import type { LogbookSettings } from '../../lib/logbook-settings';
import type { DayState } from '../../lib/packing';
import { APP_VIEW, FIELD_LABEL, FIELD_LABEL_NARROW, FIELD_INPUT, FOOT, FOOT_DOWNLOAD } from '../../lib/ui-classes';
import LogJumpForm from './logbook/LogJumpForm.astro';
import LogbookEntryList from './logbook/LogbookEntryList.astro';
import ReferenceListPanel from './logbook/ReferenceListPanel.astro';
import LogbookSettingsPanel from './logbook/LogbookSettingsPanel.astro';

interface Props {
  state: DayState;
  dateDisplay: string;
  nextLogbookNumber: number;
  logbookEntries: NumberedEntry[];
  logbookSettings: LogbookSettings;
}

const { state, dateDisplay, nextLogbookNumber, logbookEntries, logbookSettings } = Astro.props;

// ReferenceListPanel takes each list pre-shaped to its generic {id, name,
// detail?} row — only Equipment has a secondary detail line.
const places = logbookSettings.places.map((p) => ({ id: p.id, name: p.name }));
const equipment = logbookSettings.equipment.map((eq) => ({
  id: eq.id,
  name: eq.name,
  detail: [eq.canopy, eq.container, eq.aad].filter(Boolean).join(' · ') || 'No details saved',
}));
const aircraft = logbookSettings.aircraft.map((ac) => ({ id: ac.id, name: ac.plate }));
const jumpTypes = logbookSettings.jumpTypes.map((jt) => ({ id: jt.id, name: jt.name }));

// .equipment-form's fields sit right under the list, not the usual mb-3 gap.
const fieldOverride = 'mt-2.5 mb-0';
---

<div class={APP_VIEW} data-app-view="logbook" id="logbookView" hidden>
  <LogJumpForm state={state} dateDisplay={dateDisplay} nextLogbookNumber={nextLogbookNumber} logbookSettings={logbookSettings} />

  <LogbookEntryList logbookEntries={logbookEntries} />

  <ReferenceListPanel
    toggleId="placesToggle"
    panelId="placesPanel"
    label="Places"
    hint="The starred one is pre-selected whenever you start a new jump."
    listId="placesList"
    items={places}
    emptyText="No places saved yet."
    category="place"
    categoryLabel="place"
    defaultId={logbookSettings.defaultPlaceId}
    formId="placesForm"
    statusId="placesStatus"
    submitLabel="Save place"
  >
    <label class={`${FIELD_LABEL} ${fieldOverride}`}>
      <span>Name</span>
      <input type="text" id="placeName" class={FIELD_INPUT} placeholder="e.g. Langar" autocomplete="off" maxlength="80" required />
    </label>
  </ReferenceListPanel>

  <ReferenceListPanel
    toggleId="equipmentToggle"
    panelId="equipmentPanel"
    label="Equipment"
    hint="The starred one is pre-selected whenever you start a new jump."
    listId="equipmentList"
    items={equipment}
    emptyText="No equipment saved yet."
    category="equipment"
    categoryLabel="equipment"
    defaultId={logbookSettings.defaultEquipmentId}
    formId="equipmentForm"
    statusId="equipmentStatus"
    submitLabel="Save equipment"
  >
    <label class={`${FIELD_LABEL} ${fieldOverride}`}>
      <span>Name</span>
      <input type="text" id="equipmentName" class={FIELD_INPUT} placeholder="e.g. Main rig" autocomplete="off" maxlength="80" required />
    </label>
    <div class="grid grid-cols-2 gap-x-2.5 gap-y-0 max-[420px]:grid-cols-1">
      <label class={`${FIELD_LABEL} ${fieldOverride}`}>
        <span>Canopy</span>
        <input type="text" id="equipmentCanopy" class={FIELD_INPUT} placeholder="e.g. Sabre2 190" autocomplete="off" maxlength="80" />
      </label>
      <label class={`${FIELD_LABEL} ${fieldOverride}`}>
        <span>Container</span>
        <input type="text" id="equipmentContainer" class={FIELD_INPUT} placeholder="e.g. Wings X 190" autocomplete="off" maxlength="80" />
      </label>
      <label class={`${FIELD_LABEL} ${fieldOverride}`}>
        <span>AAD</span>
        <input type="text" id="equipmentAad" class={FIELD_INPUT} placeholder="e.g. Cypres 2" autocomplete="off" maxlength="80" />
      </label>
    </div>
  </ReferenceListPanel>

  <ReferenceListPanel
    toggleId="aircraftToggle"
    panelId="aircraftPanel"
    label="Aircraft"
    hint="The starred one is pre-selected whenever you start a new jump."
    listId="aircraftList"
    items={aircraft}
    emptyText="No aircraft saved yet."
    category="aircraft"
    categoryLabel="aircraft"
    defaultId={logbookSettings.defaultAircraftId}
    formId="aircraftForm"
    statusId="aircraftStatus"
    submitLabel="Save aircraft"
  >
    <label class={`${FIELD_LABEL_NARROW} ${fieldOverride}`}>
      <span>Registration</span>
      <input type="text" id="aircraftPlate" class={FIELD_INPUT} placeholder="e.g. G-SDSK" autocomplete="off" maxlength="20" required />
    </label>
  </ReferenceListPanel>

  <ReferenceListPanel
    toggleId="jumpTypesToggle"
    panelId="jumpTypesPanel"
    label="Jump types"
    hint={`The starred one is pre-selected whenever you start a new jump. "Tandem Instructor" and "Tandem Camera" are added here automatically the first time you log one from the Tandems tab.`}
    listId="jumpTypesList"
    items={jumpTypes}
    emptyText="No jump types saved yet."
    category="jumpType"
    categoryLabel="jump type"
    defaultId={logbookSettings.defaultJumpTypeId}
    formId="jumpTypesForm"
    statusId="jumpTypesStatus"
    submitLabel="Save jump type"
  >
    <label class={`${FIELD_LABEL} ${fieldOverride}`}>
      <span>Name</span>
      <input type="text" id="jumpTypeName" class={FIELD_INPUT} placeholder="e.g. Sport" autocomplete="off" maxlength="40" required />
    </label>
  </ReferenceListPanel>

  <LogbookSettingsPanel baseJumps={logbookSettings.baseJumps} />

  <footer class={FOOT}>
    <button type="button" class={FOOT_DOWNLOAD} data-download="/api/logbook-export.csv" data-download-name="logbook.csv">
      Download full logbook (.csv)
    </button>
  </footer>
</div>

<script>
  import { wireDownloadButtons, wireToggle } from '../../lib/client/dom';
  import { initLogbookJumpForm } from '../../lib/client/logbook-jump-form';
  import { initLogbookJumpNumberSettings } from '../../lib/client/logbook-jump-number-settings';
  import { initLogbookReferenceLists } from '../../lib/client/logbook-reference-lists';

  const logbookView = document.getElementById('logbookView');
  if (!logbookView) throw new Error('#logbookView not found');

  wireDownloadButtons(logbookView);
  initLogbookJumpForm();
  initLogbookJumpNumberSettings();
  initLogbookReferenceLists();
  wireToggle('logbookSettingsToggle', 'logbookSettingsPanel');
</script>
