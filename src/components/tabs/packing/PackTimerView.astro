---
// Packing tab's Timer sub-view: a stopwatch for timing one pack job, and
// the "fastest 5" board it feeds. Wired up by lib/client/packing-tab.ts's
// initPackingTimer().
import { formatDuration, formatWhen } from '../../../lib/format';
import type { PackTime } from '../../../lib/times';

interface Props {
  topTimes: PackTime[];
}

const { topTimes } = Astro.props;
---

<div class="bg-panel border border-line rounded-card shadow-card px-5 py-10 flex flex-col items-center gap-6">
  <div
    class="font-display font-bold text-[64px] tracking-[-0.02em] [font-variant-numeric:tabular-nums] text-ink"
    id="timerDisplay"
  >
    0:00.0
  </div>
  <button
    type="button"
    class="appearance-none border-0 w-full max-w-[280px] h-16 rounded-full font-display font-bold text-xl text-white bg-student cursor-pointer touch-manipulation transition-[transform,filter] duration-[80ms] ease-[ease] active:scale-[0.96] focus-visible:outline-[3px] focus-visible:outline-gold focus-visible:outline-offset-2 data-[running=true]:bg-danger"
    id="timerButton"
    data-running="false"
  >
    Start
  </button>
</div>

<section class="fastest">
  <h2 class="fastest-title">Fastest 5</h2>
  <div id="fastestBoard">
    {
      topTimes.length === 0 ? (
        <p class="fastest-empty">Time a pack job to start the board.</p>
      ) : (
        <ol class="fastest-list">
          {topTimes.map((t, i) => (
            <li class:list={['fastest-row', { 'is-first': i === 0 }]}>
              <span class="fastest-rank">{i + 1}</span>
              <span class="fastest-duration">{formatDuration(t.ms)}</span>
              <span class="fastest-when">{formatWhen(t.at)}</span>
              <button
                type="button"
                class="fastest-delete"
                data-at={t.at}
                aria-label={`Delete the ${formatDuration(t.ms)} time`}
              >
                &times;
              </button>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>

<style>
  /*
   * The whole fastest-board subtree is re-rendered client-side via
   * innerHTML (renderFastestBoard() in lib/client/packing-tab.ts), so
   * these stay plain CSS with `:global()` rather than Tailwind utilities —
   * see PackingTab.astro's original note (now here) for the full
   * reasoning.
   *
   * `:global()` on everything under #fastestBoard (but not `.fastest`/
   * `.fastest-title` themselves) because Astro's scoping only reaches
   * elements it renders itself — renderFastestBoard()'s innerHTML swap
   * produces plain unscoped markup, and the first server-rendered board
   * needs to match it so the two don't visibly differ.
   */
  .fastest {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 16px 6px;
  }

  .fastest-title {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 700;
  }

  :global(.fastest-list) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.fastest-row) {
    display: grid;
    grid-template-columns: 22px auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  :global(.fastest-row.is-first) {
    color: var(--gold);
  }

  :global(.fastest-rank) {
    color: var(--ink-soft);
    font-size: 12px;
  }

  :global(.fastest-row.is-first .fastest-rank) {
    color: var(--gold);
  }

  :global(.fastest-duration) {
    font-weight: 600;
    font-size: 16px;
  }

  :global(.fastest-when) {
    text-align: right;
    color: var(--ink-soft);
    font-size: 12px;
  }

  :global(.fastest-row.is-first .fastest-when) {
    color: inherit;
    opacity: 0.8;
  }

  :global(.fastest-delete) {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--ink-soft);
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    line-height: 1;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
  }

  :global(.fastest-delete:hover),
  :global(.fastest-delete:focus-visible) {
    background: var(--danger-soft);
    color: var(--danger);
    outline: none;
  }

  :global(.fastest-delete:active) {
    transform: scale(0.9);
  }

  :global(.fastest-empty) {
    margin: 0;
    padding: 10px 0 14px;
    color: var(--ink-soft);
    font-size: 14px;
  }
</style>
