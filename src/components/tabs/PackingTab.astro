---
// The "Packing" app tab: today's pack-job counters plus its own Pack /
// Timer sub-tabs (the counters themselves, and a stopwatch + fastest-5
// board for timing individual pack jobs). Each piece is its own component
// under tabs/packing/ — this file just lays them out and owns the props
// they're built from.
import { totalEarnings, totalPacks, type DayState } from '../../lib/packing';
import type { HistoryRow } from '../../lib/packing';
import type { AggregateRow } from '../../lib/invoice';
import type { PackTime } from '../../lib/times';
import { APP_VIEW, MASTHEAD, STAMP, STAMP_LABEL, STAMP_DATE, TOTALS, TOTALS_BLOCK, TOTALS_BLOCK_FLEX, TOTALS_VALUE_GOLD, TOTALS_VALUE_INK, TOTALS_LABEL, TOTALS_DIVIDER, FOOT, FOOT_DOWNLOAD } from '../../lib/ui-classes';
import PackCategoryCards from './packing/PackCategoryCards.astro';
import PackHistoryPanel from './packing/PackHistoryPanel.astro';
import PackTimerView from './packing/PackTimerView.astro';

interface Props {
  state: DayState;
  dateDisplay: string;
  dayRows: HistoryRow[];
  weekRows: AggregateRow[];
  monthRows: AggregateRow[];
  topTimes: PackTime[];
}

const { state, dateDisplay, dayRows, weekRows, monthRows, topTimes } = Astro.props;

const money = (n: number) => `£${n.toFixed(2)}`;
---

<div class={APP_VIEW} data-app-view="packing" id="packingView">
  <div class="flex gap-2 mb-0.5" role="tablist" aria-label="Packing view">
    <button
      type="button"
      class="flex-1 appearance-none border border-line bg-panel text-ink-soft font-sans font-bold text-sm p-2.5 rounded-[10px] cursor-pointer aria-selected:bg-ink aria-selected:border-ink aria-selected:text-canvas"
      data-sub-tab="pack"
      role="tab"
      aria-selected="true"
    >
      Pack
    </button>
    <button
      type="button"
      class="flex-1 appearance-none border border-line bg-panel text-ink-soft font-sans font-bold text-sm p-2.5 rounded-[10px] cursor-pointer aria-selected:bg-ink aria-selected:border-ink aria-selected:text-canvas"
      data-sub-tab="timer"
      role="tab"
      aria-selected="false"
    >
      Timer
    </button>
  </div>

  <div class="flex flex-col gap-[22px] [&[hidden]]:hidden" data-sub-view="pack">
    <header class={MASTHEAD}>
      <div class={STAMP} aria-hidden="false">
        <span class={STAMP_LABEL}>Manifest</span>
        <span class={STAMP_DATE} id="dateDisplay">{dateDisplay}</span>
      </div>
      <div class={TOTALS}>
        <div class={TOTALS_BLOCK}>
          <span class={TOTALS_VALUE_GOLD} id="totalEarnings">{money(totalEarnings(state.counts))}</span>
          <span class={TOTALS_LABEL}>earned today</span>
        </div>
        <div class={TOTALS_DIVIDER} aria-hidden="true"></div>
        <div class={TOTALS_BLOCK_FLEX}>
          <span class={TOTALS_VALUE_INK} id="totalPacks">{totalPacks(state.counts)}</span>
          <span class={TOTALS_LABEL}>packs today</span>
        </div>
      </div>
    </header>

    <PackCategoryCards state={state} />

    <PackHistoryPanel dayRows={dayRows} weekRows={weekRows} monthRows={monthRows} />

    <footer class={FOOT}>
      <button type="button" class={FOOT_DOWNLOAD} data-download="/api/export.csv" data-download-name="packing-log.csv">
        Download full log (.csv)
      </button>
    </footer>
  </div>

  <div class="flex flex-col gap-[22px] [&[hidden]]:hidden" data-sub-view="timer" hidden>
    <PackTimerView topTimes={topTimes} />
  </div>
</div>

<script>
  import { wireTabGroup, wireToggle, wireDownloadButtons } from '../../lib/client/dom';
  import { initPackingCounters, initPackingTimer } from '../../lib/client/packing-tab';

  const packingView = document.getElementById('packingView');
  if (!packingView) throw new Error('#packingView not found');

  wireTabGroup(packingView, '[data-sub-tab]', '[data-sub-view]', 'subTab', 'subView');

  const historyPanel = document.getElementById('historyPanel');
  if (historyPanel) wireTabGroup(historyPanel, '[data-tab]', '[data-view]', 'tab', 'view');
  wireToggle('historyToggle', 'historyPanel');

  wireDownloadButtons(packingView);

  initPackingCounters();
  initPackingTimer();
</script>
