---
// Tandems tab: the collapsible History panel, with Day/Week/Month
// sub-tabs. Day is a plain table rendered here; Week/Month reuse
// TandemAggregateTable, which also carries the "Export PDF" buttons for
// past invoice months.
import { CATEGORIES, CATEGORY_LABELS, type HistoryRow } from '../../../lib/tandem';
import type { AggregateRow } from '../../../lib/tandem-invoice';
import { CATEGORY_TEXT_CLASS } from '../../../lib/category-colors';
import {
  TOGGLE_SECTION,
  TOGGLE_BUTTON,
  TOGGLE_ICON,
  TOGGLE_PANEL,
  HISTORY_TABS,
  HISTORY_TAB,
  HISTORY_EMPTY,
  HISTORY_SCROLL,
  HISTORY_TABLE,
  HISTORY_THEAD_ROW,
  HISTORY_TBODY_ROW,
  HISTORY_CELL_LEFT,
  HISTORY_CELL_RIGHT,
} from '../../../lib/ui-classes';
import TandemAggregateTable from '../../TandemAggregateTable.astro';

interface Props {
  dayRows: HistoryRow[];
  weekRows: AggregateRow[];
  monthRows: AggregateRow[];
}

const { dayRows, weekRows, monthRows } = Astro.props;

const money = (n: number) => `£${n.toFixed(2)}`;
---

<section class={TOGGLE_SECTION}>
  <button
    class={TOGGLE_BUTTON}
    id="tandemHistoryToggle"
    type="button"
    aria-expanded="false"
    aria-controls="tandemHistoryPanel"
  >
    <span>History</span>
    <span class={TOGGLE_ICON} id="tandemHistoryToggleIcon">&rsaquo;</span>
  </button>
  <div class={TOGGLE_PANEL} id="tandemHistoryPanel" hidden>
    <div class={HISTORY_TABS} role="tablist" aria-label="Group tandem history by">
      <button type="button" class={HISTORY_TAB} data-tab="day" role="tab" aria-selected="true">Day</button>
      <button type="button" class={HISTORY_TAB} data-tab="week" role="tab" aria-selected="false">Week</button>
      <button type="button" class={HISTORY_TAB} data-tab="month" role="tab" aria-selected="false">Month</button>
    </div>

    <div data-view="day">
      {
        dayRows.length === 0 ? (
          <p class={HISTORY_EMPTY}>Nothing logged yet before today.</p>
        ) : (
          <div class={HISTORY_SCROLL}>
            <table class={HISTORY_TABLE}>
              <thead>
                <tr class={HISTORY_THEAD_ROW}>
                  <th scope="col" class={HISTORY_CELL_LEFT}>
                    Date
                  </th>
                  {CATEGORIES.map((c) => (
                    <th scope="col" class={`${HISTORY_CELL_RIGHT} ${CATEGORY_TEXT_CLASS[c]}`}>
                      {CATEGORY_LABELS[c].slice(0, 3)}
                    </th>
                  ))}
                  <th scope="col" class={HISTORY_CELL_RIGHT}>
                    Jumps
                  </th>
                  <th scope="col" class={HISTORY_CELL_RIGHT}>
                    Earned
                  </th>
                </tr>
              </thead>
              <tbody>
                {dayRows.map((row) => (
                  <tr class={HISTORY_TBODY_ROW}>
                    <td class={HISTORY_CELL_LEFT}>{row.date}</td>
                    {CATEGORIES.map((c) => (
                      <td class={`${HISTORY_CELL_RIGHT} ${CATEGORY_TEXT_CLASS[c]}`}>{row.counts[c]}</td>
                    ))}
                    <td class={HISTORY_CELL_RIGHT}>{row.totalJumps}</td>
                    <td class={HISTORY_CELL_RIGHT}>{money(row.totalEarnings)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div data-view="week" hidden>
      <TandemAggregateTable rows={weekRows} currentLabel="This week" prefix="tweek" />
    </div>

    <div data-view="month" hidden>
      <TandemAggregateTable rows={monthRows} currentLabel="This invoice month" prefix="tmonth" />
    </div>
  </div>
</section>
