---
// Tandems tab: the invoice letterhead settings form — your details, who
// it's billed to, and the next invoice number, used on the "Export PDF"
// invoices in TandemHistoryPanel's Month view. Submit handling lives in
// lib/client/tandems-invoice-settings.ts.
import type { InvoiceSettings } from '../../../lib/invoice-settings';
import {
  TOGGLE_SECTION,
  TOGGLE_BUTTON,
  TOGGLE_ICON,
  TOGGLE_PANEL,
  TOGGLE_PANEL_PADDED,
  FIELD_LABEL,
  FIELD_LABEL_NARROW,
  FIELD_INPUT,
  FORM_ACTIONS,
  FORM_SAVE_BUTTON,
  FORM_STATUS,
  PANEL_HINT,
} from '../../../lib/ui-classes';

interface Props {
  invoiceSettings: InvoiceSettings;
}

const { invoiceSettings } = Astro.props;
---

<section class={TOGGLE_SECTION}>
  <button
    class={TOGGLE_BUTTON}
    id="invoiceSettingsToggle"
    type="button"
    aria-expanded="false"
    aria-controls="invoiceSettingsPanel"
  >
    <span>Invoice details</span>
    <span class={TOGGLE_ICON} id="invoiceSettingsToggleIcon">&rsaquo;</span>
  </button>
  <div class={`${TOGGLE_PANEL} ${TOGGLE_PANEL_PADDED}`} id="invoiceSettingsPanel" hidden>
    <p class={PANEL_HINT}>
      Used on the "Export PDF" invoices below — your details, who it's billed to, and the next invoice number.
    </p>
    <form id="invoiceSettingsForm">
      <label class={FIELD_LABEL}>
        <span>Your name</span>
        <input type="text" id="invoiceFromName" class={FIELD_INPUT} value={invoiceSettings.fromName} required />
      </label>
      <label class={FIELD_LABEL}>
        <span>Your address (one line each)</span>
        <textarea id="invoiceFromAddress" class={FIELD_INPUT} rows="4">{invoiceSettings.fromAddress.join('\n')}</textarea>
      </label>
      <label class={FIELD_LABEL}>
        <span>VAT note</span>
        <input type="text" id="invoiceVatNote" class={FIELD_INPUT} value={invoiceSettings.vatNote} />
      </label>
      <label class={FIELD_LABEL}>
        <span>Bill to (one line each)</span>
        <textarea id="invoiceBillTo" class={FIELD_INPUT} rows="4">{invoiceSettings.billTo.join('\n')}</textarea>
      </label>
      <label class={FIELD_LABEL_NARROW}>
        <span>Next invoice ref</span>
        <input
          type="number"
          id="invoiceNextRef"
          class={FIELD_INPUT}
          min="1"
          step="1"
          value={invoiceSettings.nextInvoiceRef}
          required
        />
      </label>
      <div class={FORM_ACTIONS}>
        <button type="submit" class={FORM_SAVE_BUTTON}>Save details</button>
        <span class={FORM_STATUS} id="invoiceSettingsStatus" role="status"></span>
      </div>
    </form>
  </div>
</section>
