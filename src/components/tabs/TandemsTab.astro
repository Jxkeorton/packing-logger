---
// The "Tandems" app tab: today's tandem jump log (credited per-customer,
// unlike the plain pack-job counters), its history, the invoice letterhead
// settings used when exporting a month's invoice PDF, and the "who's the
// customer?" modal shown when adding a jump. Each of those pieces is its
// own component under tabs/tandems/ (or, for the modal, a top-level
// shared one) — this file just lays them out and owns the props they're
// built from.
import { totalEarnings, totalJumps, type DayState, type HistoryRow } from '../../lib/tandem';
import type { AggregateRow } from '../../lib/tandem-invoice';
import type { InvoiceSettings } from '../../lib/invoice-settings';
import {
  APP_VIEW,
  MASTHEAD,
  STAMP,
  STAMP_LABEL,
  STAMP_DATE,
  TOTALS,
  TOTALS_BLOCK,
  TOTALS_BLOCK_FLEX,
  TOTALS_VALUE_GOLD,
  TOTALS_VALUE_INK,
  TOTALS_LABEL,
  TOTALS_DIVIDER,
  FOOT,
  FOOT_DOWNLOAD,
} from '../../lib/ui-classes';
import TandemCategoryCards from './tandems/TandemCategoryCards.astro';
import TandemHistoryPanel from './tandems/TandemHistoryPanel.astro';
import InvoiceSettingsPanel from './tandems/InvoiceSettingsPanel.astro';
import TandemNameModal from '../TandemNameModal.astro';

interface Props {
  tandemState: DayState;
  dateDisplay: string;
  dayRows: HistoryRow[];
  weekRows: AggregateRow[];
  monthRows: AggregateRow[];
  invoiceSettings: InvoiceSettings;
}

const { tandemState, dateDisplay, dayRows, weekRows, monthRows, invoiceSettings } = Astro.props;

const money = (n: number) => `£${n.toFixed(2)}`;
---

<div class={APP_VIEW} data-app-view="tandems" id="tandemsView" hidden>
  <header class={MASTHEAD}>
    <div class={STAMP} aria-hidden="false">
      <span class={STAMP_LABEL}>Tandem Log</span>
      <span class={STAMP_DATE}>{dateDisplay}</span>
    </div>
    <div class={TOTALS}>
      <div class={TOTALS_BLOCK}>
        <span class={TOTALS_VALUE_GOLD} id="tandemTotalEarnings">{money(totalEarnings(tandemState.counts))}</span>
        <span class={TOTALS_LABEL}>earned today</span>
      </div>
      <div class={TOTALS_DIVIDER} aria-hidden="true"></div>
      <div class={TOTALS_BLOCK_FLEX}>
        <span class={TOTALS_VALUE_INK} id="tandemTotalJumps">{totalJumps(tandemState.counts)}</span>
        <span class={TOTALS_LABEL}>jumps today</span>
      </div>
    </div>
  </header>

  <TandemCategoryCards tandemState={tandemState} />

  <TandemHistoryPanel dayRows={dayRows} weekRows={weekRows} monthRows={monthRows} />

  <InvoiceSettingsPanel invoiceSettings={invoiceSettings} />

  <footer class={FOOT}>
    <button
      type="button"
      class={FOOT_DOWNLOAD}
      data-download="/api/tandem-export.csv"
      data-download-name="tandem-log.csv"
    >
      Download full tandem log (.csv)
    </button>
  </footer>

  <TandemNameModal />
</div>

<script>
  import { wireTabGroup, wireToggle, wireDownloadButtons, downloadFile } from '../../lib/client/dom';
  import { initTandemJumpLog } from '../../lib/client/tandems-jump-log';
  import { initTandemInvoiceSettings } from '../../lib/client/tandems-invoice-settings';

  const tandemsView = document.getElementById('tandemsView');
  if (!tandemsView) throw new Error('#tandemsView not found');

  const tandemHistoryPanel = document.getElementById('tandemHistoryPanel');
  if (tandemHistoryPanel) wireTabGroup(tandemHistoryPanel, '[data-tab]', '[data-view]', 'tab', 'view');
  wireToggle('tandemHistoryToggle', 'tandemHistoryPanel');
  wireToggle('invoiceSettingsToggle', 'invoiceSettingsPanel');

  wireDownloadButtons(tandemsView);

  tandemsView.querySelectorAll<HTMLButtonElement>('[data-invoice-month]').forEach((button) => {
    button.addEventListener('click', () => {
      const month = button.dataset.invoiceMonth!;
      void downloadFile(`/api/tandem-invoice.pdf?month=${encodeURIComponent(month)}`, 'invoice.pdf', button);
    });
  });

  initTandemJumpLog(tandemsView);
  initTandemInvoiceSettings();
</script>
