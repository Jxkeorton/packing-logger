---
// Logbook tab: shared shell for the four "saved profile" toggle panels —
// Places, Equipment, Aircraft, Jump types. All four are the same shape
// (hint, starred/deletable list, small create form); only the form's own
// fields differ; passed in via the default slot. Client-side wiring for
// all four lives in lib/client/logbook-reference-lists.ts.
import {
  TOGGLE_SECTION,
  TOGGLE_BUTTON,
  TOGGLE_ICON,
  TOGGLE_PANEL,
  TOGGLE_PANEL_PADDED,
  FORM_ACTIONS,
  FORM_SAVE_BUTTON,
  FORM_STATUS,
  PANEL_HINT,
} from '../../../lib/ui-classes';

interface Item {
  id: string;
  name: string;
  detail?: string;
}

interface Props {
  toggleId: string;
  panelId: string;
  label: string;
  hint: string;
  listId: string;
  items: Item[];
  emptyText: string;
  category: string;
  categoryLabel: string;
  defaultId: string | null;
  formId: string;
  statusId: string;
  submitLabel: string;
}

const {
  toggleId,
  panelId,
  label,
  hint,
  listId,
  items,
  emptyText,
  category,
  categoryLabel,
  defaultId,
  formId,
  statusId,
  submitLabel,
} = Astro.props;
---

<section class={TOGGLE_SECTION}>
  <button class={TOGGLE_BUTTON} id={toggleId} type="button" aria-expanded="false" aria-controls={panelId}>
    <span>{label}</span>
    <span class={TOGGLE_ICON} id={`${toggleId}Icon`}>&rsaquo;</span>
  </button>
  <div class={`${TOGGLE_PANEL} ${TOGGLE_PANEL_PADDED}`} id={panelId} hidden>
    <p class={PANEL_HINT}>{hint}</p>
    <ul class="list-none mt-0 mb-3 p-0" id={listId}>
      {
        items.length === 0 ? (
          <li class="equipment-empty">{emptyText}</li>
        ) : (
          items.map((item) => (
            <li class="equipment-row" data-id={item.id}>
              <div class="equipment-row-text">
                <span class="equipment-row-name">{item.name}</span>
                {item.detail && <span class="equipment-row-detail">{item.detail}</span>}
              </div>
              <button
                type="button"
                class="default-star"
                data-default-category={category}
                data-default-id={item.id}
                aria-pressed={item.id === defaultId ? 'true' : 'false'}
                aria-label={`Set ${item.name} as the default ${categoryLabel}`}
              >
                &#9733;
              </button>
              <button type="button" class="equipment-delete" data-ref-delete={item.id} aria-label={`Remove ${item.name}`}>
                &times;
              </button>
            </li>
          ))
        )
      }
    </ul>
    <form id={formId} class="pt-1 border-t border-line">
      <slot />
      <div class={FORM_ACTIONS}>
        <button type="submit" class={FORM_SAVE_BUTTON}>{submitLabel}</button>
        <span class={FORM_STATUS} id={statusId} role="status"></span>
      </div>
    </form>
  </div>
</section>

<style>
  /*
   * Re-rendered client-side (via innerHTML, in wireReferenceList's `apply`
   * — see lib/client/reference-list.ts) after every add/delete/default
   * change, so these stay plain CSS with `:global()` rather than Tailwind
   * utilities — see PackingTab.astro's <style> block for the full
   * reasoning. Shared by all four reference-list panels, not just
   * whichever one happens to render first.
   */
  :global(.equipment-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 2px;
    border-top: 1px solid var(--line);
  }

  :global(.equipment-row:first-child) {
    border-top: none;
  }

  :global(.equipment-row-text) {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }

  :global(.equipment-row-name) {
    font-size: 13.5px;
    font-weight: 600;
  }

  :global(.equipment-row-detail) {
    font-size: 12px;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.equipment-delete) {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--ink-soft);
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    line-height: 1;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
  }

  :global(.equipment-delete:hover),
  :global(.equipment-delete:focus-visible) {
    background: var(--danger-soft);
    color: var(--danger);
    outline: none;
  }

  :global(.default-star) {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--line-strong);
    font-size: 16px;
    line-height: 1;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
  }

  :global(.default-star:hover),
  :global(.default-star:focus-visible) {
    background: var(--panel);
    color: var(--gold);
    outline: none;
  }

  :global(.default-star[aria-pressed='true']) {
    color: var(--gold);
  }

  :global(.default-star:disabled) {
    opacity: 0.5;
    cursor: default;
  }

  :global(.equipment-empty) {
    margin: 0 0 12px;
    padding: 9px 2px;
    color: var(--ink-soft);
    font-size: 13px;
  }
</style>
