---
// Logbook tab: the "jumps logged before this app" starting-number setting.
// Saving it shifts every jump number downstream, including the Log
// sub-tab's React island — see lib/client/logbook-jump-number-settings.ts
// for how a save reaches that.
import {
  TOGGLE_SECTION,
  TOGGLE_BUTTON,
  TOGGLE_ICON,
  TOGGLE_PANEL,
  TOGGLE_PANEL_PADDED,
  FIELD_LABEL_NARROW,
  FIELD_INPUT,
  FORM_ACTIONS,
  FORM_SAVE_BUTTON,
  FORM_STATUS,
  PANEL_HINT,
} from '../../../lib/ui-classes';

interface Props {
  baseJumps: number;
}

const { baseJumps } = Astro.props;
---

<section class={TOGGLE_SECTION}>
  <button
    class={TOGGLE_BUTTON}
    id="logbookSettingsToggle"
    type="button"
    aria-expanded="false"
    aria-controls="logbookSettingsPanel"
  >
    <span>Settings</span>
    <span class={TOGGLE_ICON} id="logbookSettingsToggleIcon">&rsaquo;</span>
  </button>
  <div class={`${TOGGLE_PANEL} ${TOGGLE_PANEL_PADDED}`} id="logbookSettingsPanel" hidden>
    <p class={PANEL_HINT}>
      Jumps you logged before using this app — added to the count above so numbering carries on correctly.
    </p>
    <form id="logbookSettingsForm">
      <label class={FIELD_LABEL_NARROW}>
        <span>Jumps logged before this app</span>
        <input type="number" id="logbookBaseJumps" class={FIELD_INPUT} min="0" step="1" value={baseJumps} required />
      </label>
      <div class={FORM_ACTIONS}>
        <button type="submit" class={FORM_SAVE_BUTTON}>Save</button>
        <span class={FORM_STATUS} id="logbookSettingsStatus" role="status"></span>
      </div>
    </form>
  </div>
</section>
