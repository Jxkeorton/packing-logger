---
// Logbook tab: the date stamp + running total, and the "log a jump" form
// itself. Submitting it, and populating it for an edit, is wired up by
// lib/client/logbook-jump-form.ts against the entry list in
// LogbookEntryList.astro alongside it.
import type { LogbookSettings } from '../../../lib/logbook-settings';
import type { DayState } from '../../../lib/packing';
import {
  MASTHEAD,
  STAMP,
  STAMP_LABEL,
  STAMP_DATE,
  TOTALS,
  TOTALS_BLOCK_FLEX,
  TOTALS_VALUE_INK,
  TOTALS_LABEL,
  FIELD_LABEL,
  FIELD_INPUT,
  FIELD_SELECT,
  FORM_ACTIONS,
  FORM_SAVE_BUTTON,
  FORM_STATUS,
} from '../../../lib/ui-classes';

interface Props {
  state: DayState;
  dateDisplay: string;
  nextLogbookNumber: number;
  logbookSettings: LogbookSettings;
}

const { state, dateDisplay, nextLogbookNumber, logbookSettings } = Astro.props;
---

<header class={MASTHEAD}>
  <div class={STAMP} aria-hidden="false">
    <span class={STAMP_LABEL}>Logbook</span>
    <span class={STAMP_DATE}>{dateDisplay}</span>
  </div>
  <div class={TOTALS}>
    <div class={TOTALS_BLOCK_FLEX}>
      <span class={TOTALS_VALUE_INK} id="logbookTotalJumps">{nextLogbookNumber - 1}</span>
      <span class={TOTALS_LABEL}>jumps logged</span>
    </div>
  </div>
</header>

<section class="bg-panel border border-line rounded-card shadow-card px-4 pt-3.5 pb-4">
  <div class="flex items-baseline justify-between gap-2 mb-2.5">
    <h2 class="m-0 text-[17px] font-bold tracking-[-0.01em]" id="logbookFormTitle">Log a jump</h2>
    <span class="font-mono font-semibold text-sm text-gold" id="logbookNextNumber">#{nextLogbookNumber}</span>
  </div>
  <form id="logbookForm">
    <input type="hidden" id="logbookEditingAt" value="" />
    <div class="grid grid-cols-2 gap-x-2.5 gap-y-0 max-[420px]:grid-cols-1">
      <label class={FIELD_LABEL}>
        <span>Date *</span>
        <input type="date" id="logbookDate" class={FIELD_INPUT} required value={state.date} />
      </label>
      <label class={FIELD_LABEL}>
        <span>Place</span>
        <select id="logbookPlace" class={FIELD_SELECT}>
          <option value="" selected={!logbookSettings.defaultPlaceId || undefined}>
            No place selected
          </option>
          {
            logbookSettings.places.map((p) => (
              <option value={p.id} selected={p.id === logbookSettings.defaultPlaceId || undefined}>
                {p.name}
              </option>
            ))
          }
        </select>
      </label>
      <label class={FIELD_LABEL}>
        <span>Exit altitude</span>
        <input
          type="text"
          id="logbookAltitude"
          class={FIELD_INPUT}
          placeholder="e.g. 13,000 ft"
          autocomplete="off"
          maxlength="120"
        />
      </label>
      <label class={FIELD_LABEL}>
        <span>Equipment</span>
        <select id="logbookEquipment" class={FIELD_SELECT}>
          <option value="" data-canopy="" data-container="" data-aad="" selected={!logbookSettings.defaultEquipmentId || undefined}>
            No equipment selected
          </option>
          {
            logbookSettings.equipment.map((eq) => (
              <option
                value={eq.id}
                data-canopy={eq.canopy}
                data-container={eq.container}
                data-aad={eq.aad}
                selected={eq.id === logbookSettings.defaultEquipmentId || undefined}
              >
                {eq.name}
              </option>
            ))
          }
        </select>
      </label>
      <label class={FIELD_LABEL}>
        <span>Aircraft</span>
        <select id="logbookAircraft" class={FIELD_SELECT}>
          <option value="" selected={!logbookSettings.defaultAircraftId || undefined}>
            No aircraft selected
          </option>
          {
            logbookSettings.aircraft.map((ac) => (
              <option value={ac.id} selected={ac.id === logbookSettings.defaultAircraftId || undefined}>
                {ac.plate}
              </option>
            ))
          }
        </select>
      </label>
      <label class={FIELD_LABEL}>
        <span>Jump type</span>
        <select id="logbookJumpType" class={FIELD_SELECT}>
          <option value="" selected={!logbookSettings.defaultJumpTypeId || undefined}>
            No jump type selected
          </option>
          {
            logbookSettings.jumpTypes.map((jt) => (
              <option value={jt.id} selected={jt.id === logbookSettings.defaultJumpTypeId || undefined}>
                {jt.name}
              </option>
            ))
          }
        </select>
      </label>
    </div>
    <label class={FIELD_LABEL}>
      <span>Description</span>
      <textarea id="logbookDescription" class={FIELD_INPUT} rows="3" placeholder="Freefall, exercises, canopy notes…"
      ></textarea>
    </label>
    <div class={FORM_ACTIONS}>
      <button type="submit" class={FORM_SAVE_BUTTON} id="logbookSubmit">Log jump</button>
      <button
        type="button"
        class="appearance-none border-0 bg-transparent text-ink-soft font-sans text-[13px] font-semibold cursor-pointer p-0 underline"
        id="logbookCancelEdit"
        hidden
      >
        Cancel edit
      </button>
      <span class={FORM_STATUS} id="logbookFormStatus" role="status"></span>
    </div>
  </form>
</section>
