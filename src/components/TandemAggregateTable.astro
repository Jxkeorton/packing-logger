---
import { CATEGORIES, CATEGORY_LABELS } from '../lib/tandem';
import type { AggregateRow } from '../lib/tandem-invoice';

interface Props {
  rows: AggregateRow[];
  currentLabel: string;
  prefix: 'tweek' | 'tmonth';
}

const { rows, currentLabel, prefix } = Astro.props;

const money = (n: number) => `£${n.toFixed(2)}`;
---

<div class="history-scroll">
  <table class="history-table">
    <thead>
      <tr>
        <th scope="col">Range</th>
        {
          CATEGORIES.map((c) => (
            <th scope="col" class={`th-${c}`}>
              {CATEGORY_LABELS[c].slice(0, 3)}
            </th>
          ))
        }
        <th scope="col">Jumps</th>
        <th scope="col">Earned</th>
        {prefix === 'tmonth' && <th scope="col">Invoice</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class={row.isCurrent ? 'is-current' : undefined} data-current-row={row.isCurrent ? prefix : undefined}>
            <td class="history-date">
              {row.isCurrent ? (
                <>
                  <span class="current-label">{currentLabel}</span>
                  <span class="current-range">{row.rangeLabel}</span>
                </>
              ) : (
                row.rangeLabel
              )}
            </td>
            {CATEGORIES.map((c) => (
              <td class={`td-${c}`} data-agg-count={row.isCurrent ? `${prefix}:${c}` : undefined}>
                {row.counts[c]}
              </td>
            ))}
            <td data-agg-total={row.isCurrent ? `${prefix}:jumps` : undefined}>{row.totalJumps}</td>
            <td data-agg-total={row.isCurrent ? `${prefix}:earnings` : undefined}>{money(row.totalEarnings)}</td>
            {prefix === 'tmonth' && (
              <td class="invoice-cell">
                <button type="button" class="invoice-export" data-invoice-month={row.key}>
                  Export PDF
                </button>
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .is-current {
    background: var(--panel-strong, rgba(184, 134, 46, 0.08));
  }

  .current-label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    color: var(--gold);
    font-size: 12px;
  }

  .current-range {
    display: block;
    font-size: 11px;
    color: var(--ink-soft);
  }

  .invoice-cell {
    text-align: right;
  }

  .invoice-export {
    appearance: none;
    display: inline-block;
    border: none;
    background: transparent;
    padding: 0;
    font-family: 'Inter', sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
    cursor: pointer;
  }

  .invoice-export:disabled {
    opacity: 0.6;
    cursor: default;
  }
</style>
