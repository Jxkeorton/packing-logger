---
// The "who's the customer?" prompt shown when adding a tandem jump. Pure
// markup — its open/close/submit behaviour lives in TandemsTab.astro
// alongside the rest of the add-jump flow it's part of.
---

<div
  class="fixed inset-0 bg-[rgba(11,22,32,0.5)] flex items-center justify-center p-4 z-20 [&[hidden]]:hidden"
  id="tandemNameModal"
  hidden
>
  <div
    class="w-full max-w-[400px] bg-panel rounded-card shadow-card p-5"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tandemNameModalTitle"
  >
    <h2 class="m-0 mb-0.5 text-[17px] font-bold" id="tandemNameModalTitle">Customer name</h2>
    <p class="mt-0 mb-3.5 text-[13px] text-ink-soft" id="tandemNameModalSubtitle">&nbsp;</p>
    <form id="tandemNameForm">
      <input
        type="text"
        id="tandemNameInput"
        class="w-full h-12 px-3.5 rounded-[10px] border border-line-strong bg-canvas text-ink font-sans text-base focus-visible:outline-[3px] focus-visible:outline-gold focus-visible:outline-offset-1"
        placeholder="e.g. Jane Smith"
        autocomplete="off"
        maxlength="80"
        required
      />
      <div class="flex gap-2.5 mt-3.5">
        <button
          type="button"
          class="flex-1 appearance-none border border-line-strong rounded-[10px] h-[46px] font-display font-bold text-[15px] cursor-pointer touch-manipulation bg-transparent text-ink-soft"
          id="tandemNameCancel"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="flex-1 appearance-none border-0 rounded-[10px] h-[46px] font-display font-bold text-[15px] cursor-pointer touch-manipulation bg-gold text-white disabled:opacity-60 disabled:cursor-default"
        >
          Add jump
        </button>
      </div>
    </form>
  </div>
</div>
