---
import {
  CATEGORIES,
  CATEGORY_LABELS,
  RATES,
  loadTodayState,
  readHistory,
  toHistoryRow,
  totalEarnings,
  totalPacks,
} from '../lib/packing';
import { groupByInvoiceMonth, groupByWeek } from '../lib/invoice';
import {
  CATEGORIES as TANDEM_CATEGORIES,
  CATEGORY_LABELS as TANDEM_CATEGORY_LABELS,
  RATES as TANDEM_RATES,
  loadTodayState as loadTodayTandemState,
  readHistory as readTandemHistory,
  toHistoryRow as toTandemHistoryRow,
  totalEarnings as totalTandemEarnings,
  totalJumps,
} from '../lib/tandem';
import { groupByInvoiceMonth as groupTandemByInvoiceMonth, groupByWeek as groupTandemByWeek } from '../lib/tandem-invoice';
import { readInvoiceSettings } from '../lib/invoice-settings';
import { formatDuration, formatWhen } from '../lib/format';
import { readFastestFive } from '../lib/times';
import { authEnabled } from '../lib/auth';
import AggregateTable from '../components/AggregateTable.astro';
import TandemAggregateTable from '../components/TandemAggregateTable.astro';

const state = await loadTodayState();
const topTimes = await readFastestFive();
const showLogout = authEnabled();

// A wider window of history feeds the week/month rollups; the day-by-day
// table only shows the most recent slice of it.
const fullHistory = await readHistory(400);
const dayRows = fullHistory.slice(0, 14);

// Today isn't in the CSV-backed history yet (it's still being logged), but
// it belongs in this week's and this invoice month's running totals.
const combined = [...fullHistory, toHistoryRow(state)];
const weekRows = groupByWeek(combined).slice(0, 12);
const monthRows = groupByInvoiceMonth(combined).slice(0, 12);

// Same shape again, for the separate tandem-jump log.
const tandemState = await loadTodayTandemState();
const tandemFullHistory = await readTandemHistory(400);
const tandemDayRows = tandemFullHistory.slice(0, 14);
const tandemCombined = [...tandemFullHistory, toTandemHistoryRow(tandemState)];
const tandemWeekRows = groupTandemByWeek(tandemCombined).slice(0, 12);
const tandemMonthRows = groupTandemByInvoiceMonth(tandemCombined).slice(0, 12);

const invoiceSettings = await readInvoiceSettings();

const dateObj = new Date(`${state.date}T00:00:00`);
const dateDisplay = dateObj.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
});

const money = (n: number) => `£${n.toFixed(2)}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#122c41" />
    <meta name="generator" content={Astro.generator} />
    <title>Packing Log</title>
    <meta name="description" content="Daily pack job and tandem jump counter and earnings log for a skydive rigger." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <div class="app-tabs" role="tablist" aria-label="Section">
        <button type="button" class="app-tab" data-app-tab="packing" role="tab" aria-selected="true">Packing</button>
        <button type="button" class="app-tab" data-app-tab="tandems" role="tab" aria-selected="false">Tandems</button>
      </div>

      <div class="app-view" data-app-view="packing" id="packingView">
        <div class="sub-tabs" role="tablist" aria-label="Packing view">
          <button type="button" class="sub-tab" data-sub-tab="pack" role="tab" aria-selected="true">Pack</button>
          <button type="button" class="sub-tab" data-sub-tab="timer" role="tab" aria-selected="false">Timer</button>
        </div>

        <div class="sub-view" data-sub-view="pack">
          <header class="masthead">
            <div class="stamp" aria-hidden="false">
              <span class="stamp-label">Manifest</span>
              <span class="stamp-date" id="dateDisplay">{dateDisplay}</span>
            </div>
            <div class="totals">
              <div class="totals-block">
                <span class="totals-value" id="totalEarnings">{money(totalEarnings(state.counts))}</span>
                <span class="totals-label">earned today</span>
              </div>
              <div class="totals-divider" aria-hidden="true"></div>
              <div class="totals-block totals-block--packs">
                <span class="totals-value totals-value--packs" id="totalPacks">{totalPacks(state.counts)}</span>
                <span class="totals-label">packs today</span>
              </div>
            </div>
          </header>

          <main class="categories">
            {
              CATEGORIES.map((category) => (
                <section class="card" data-category={category}>
                  <div class="card-top">
                    <h2 class="card-label">{CATEGORY_LABELS[category]}</h2>
                    <span class="card-rate">£{RATES[category].toFixed(2)} / pack</span>
                  </div>
                  <div class="card-controls">
                    <button
                      class="stepper stepper--minus"
                      type="button"
                      data-action="decrement"
                      data-category={category}
                      aria-label={`Remove one ${CATEGORY_LABELS[category]} pack job`}
                    >
                      &minus;
                    </button>
                    <span class="card-count" data-count={category}>
                      {state.counts[category]}
                    </span>
                    <button
                      class="stepper stepper--plus"
                      type="button"
                      data-action="increment"
                      data-category={category}
                      aria-label={`Add one ${CATEGORY_LABELS[category]} pack job`}
                    >
                      &plus;
                    </button>
                  </div>
                  <div class="card-subtotal" data-subtotal={category}>
                    £{(state.counts[category] * RATES[category]).toFixed(2)}
                  </div>
                </section>
              ))
            }
          </main>

          <section class="history">
            <button class="history-toggle" id="historyToggle" type="button" aria-expanded="false" aria-controls="historyPanel">
              <span>History</span>
              <span class="history-toggle-icon" id="historyToggleIcon">&rsaquo;</span>
            </button>
            <div class="history-panel" id="historyPanel" hidden>
              <div class="history-tabs" role="tablist" aria-label="Group history by">
                <button type="button" class="history-tab" data-tab="day" role="tab" aria-selected="true">Day</button>
                <button type="button" class="history-tab" data-tab="week" role="tab" aria-selected="false">Week</button>
                <button type="button" class="history-tab" data-tab="month" role="tab" aria-selected="false">Month</button>
              </div>

              <div class="history-view" data-view="day">
                {
                  dayRows.length === 0 ? (
                    <p class="history-empty">Nothing logged yet before today.</p>
                  ) : (
                    <div class="history-scroll">
                      <table class="history-table">
                        <thead>
                          <tr>
                            <th scope="col">Date</th>
                            {CATEGORIES.map((c) => (
                              <th scope="col" class={`th-${c}`}>
                                {CATEGORY_LABELS[c].slice(0, 3)}
                              </th>
                            ))}
                            <th scope="col">Packs</th>
                            <th scope="col">Earned</th>
                          </tr>
                        </thead>
                        <tbody>
                          {dayRows.map((row) => (
                            <tr>
                              <td class="history-date">{row.date}</td>
                              {CATEGORIES.map((c) => (
                                <td class={`td-${c}`}>{row.counts[c]}</td>
                              ))}
                              <td>{row.totalPacks}</td>
                              <td>{money(row.totalEarnings)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )
                }
              </div>

              <div class="history-view" data-view="week" hidden>
                <AggregateTable rows={weekRows} currentLabel="This week" prefix="week" />
              </div>

              <div class="history-view" data-view="month" hidden>
                <AggregateTable rows={monthRows} currentLabel="This invoice month" prefix="month" />
              </div>
            </div>
          </section>

          <footer class="foot">
            <a class="foot-download" href="/api/export.csv" download>Download full log (.csv)</a>
          </footer>
        </div>

        <div class="sub-view" data-sub-view="timer" hidden>
          <div class="timer">
            <div class="timer-display" id="timerDisplay">0:00.0</div>
            <button type="button" class="timer-button" id="timerButton" data-running="false">Start</button>
          </div>

          <section class="fastest">
            <h2 class="fastest-title">Fastest 5</h2>
            <div id="fastestBoard">
              {
                topTimes.length === 0 ? (
                  <p class="fastest-empty">Time a pack job to start the board.</p>
                ) : (
                  <ol class="fastest-list">
                    {topTimes.map((t, i) => (
                      <li class:list={['fastest-row', { 'is-first': i === 0 }]}>
                        <span class="fastest-rank">{i + 1}</span>
                        <span class="fastest-duration">{formatDuration(t.ms)}</span>
                        <span class="fastest-when">{formatWhen(t.at)}</span>
                        <button
                          type="button"
                          class="fastest-delete"
                          data-at={t.at}
                          aria-label={`Delete the ${formatDuration(t.ms)} time`}
                        >
                          &times;
                        </button>
                      </li>
                    ))}
                  </ol>
                )
              }
            </div>
          </section>
        </div>
      </div>

      <div class="app-view" data-app-view="tandems" id="tandemsView" hidden>
        <header class="masthead">
          <div class="stamp" aria-hidden="false">
            <span class="stamp-label">Tandem Log</span>
            <span class="stamp-date">{dateDisplay}</span>
          </div>
          <div class="totals">
            <div class="totals-block">
              <span class="totals-value" id="tandemTotalEarnings">{money(totalTandemEarnings(tandemState.counts))}</span>
              <span class="totals-label">earned today</span>
            </div>
            <div class="totals-divider" aria-hidden="true"></div>
            <div class="totals-block totals-block--packs">
              <span class="totals-value totals-value--packs" id="tandemTotalJumps">{totalJumps(tandemState.counts)}</span>
              <span class="totals-label">jumps today</span>
            </div>
          </div>
        </header>

        <section class="categories">
          {
            TANDEM_CATEGORIES.map((category) => (
              <section class="card" data-tandem-category={category}>
                <div class="card-top">
                  <h2 class="card-label">{TANDEM_CATEGORY_LABELS[category]}</h2>
                  <span class="card-rate">£{TANDEM_RATES[category].toFixed(2)} / jump</span>
                </div>
                <button type="button" class="tandem-add" data-tandem-add={category}>
                  &plus; Add {TANDEM_CATEGORY_LABELS[category].toLowerCase()} jump
                </button>
                <ul class="tandem-jump-list" data-tandem-list={category}>
                  {tandemState.entries[category].length === 0 ? (
                    <li class="tandem-jump-empty">No jumps logged yet today.</li>
                  ) : (
                    tandemState.entries[category].map((jump) => (
                      <li class="tandem-jump-row" data-at={jump.at}>
                        <span class="tandem-jump-name">{jump.name}</span>
                        <button
                          type="button"
                          class="tandem-jump-delete"
                          data-at={jump.at}
                          aria-label={`Remove ${jump.name}`}
                        >
                          &times;
                        </button>
                      </li>
                    ))
                  )}
                </ul>
                <div class="card-subtotal" data-tandem-subtotal={category}>
                  £{(tandemState.counts[category] * TANDEM_RATES[category]).toFixed(2)}
                </div>
              </section>
            ))
          }
        </section>

        <section class="history">
          <button class="history-toggle" id="tandemHistoryToggle" type="button" aria-expanded="false" aria-controls="tandemHistoryPanel">
            <span>History</span>
            <span class="history-toggle-icon" id="tandemHistoryToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel" id="tandemHistoryPanel" hidden>
            <div class="history-tabs" role="tablist" aria-label="Group tandem history by">
              <button type="button" class="history-tab" data-tab="day" role="tab" aria-selected="true">Day</button>
              <button type="button" class="history-tab" data-tab="week" role="tab" aria-selected="false">Week</button>
              <button type="button" class="history-tab" data-tab="month" role="tab" aria-selected="false">Month</button>
            </div>

            <div class="history-view" data-view="day">
              {
                tandemDayRows.length === 0 ? (
                  <p class="history-empty">Nothing logged yet before today.</p>
                ) : (
                  <div class="history-scroll">
                    <table class="history-table">
                      <thead>
                        <tr>
                          <th scope="col">Date</th>
                          {TANDEM_CATEGORIES.map((c) => (
                            <th scope="col" class={`th-${c}`}>
                              {TANDEM_CATEGORY_LABELS[c].slice(0, 3)}
                            </th>
                          ))}
                          <th scope="col">Jumps</th>
                          <th scope="col">Earned</th>
                        </tr>
                      </thead>
                      <tbody>
                        {tandemDayRows.map((row) => (
                          <tr>
                            <td class="history-date">{row.date}</td>
                            {TANDEM_CATEGORIES.map((c) => (
                              <td class={`td-${c}`}>{row.counts[c]}</td>
                            ))}
                            <td>{row.totalJumps}</td>
                            <td>{money(row.totalEarnings)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </div>

            <div class="history-view" data-view="week" hidden>
              <TandemAggregateTable rows={tandemWeekRows} currentLabel="This week" prefix="tweek" />
            </div>

            <div class="history-view" data-view="month" hidden>
              <TandemAggregateTable rows={tandemMonthRows} currentLabel="This invoice month" prefix="tmonth" />
            </div>
          </div>
        </section>

        <section class="history">
          <button
            class="history-toggle"
            id="invoiceSettingsToggle"
            type="button"
            aria-expanded="false"
            aria-controls="invoiceSettingsPanel"
          >
            <span>Invoice details</span>
            <span class="history-toggle-icon" id="invoiceSettingsToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="invoiceSettingsPanel" hidden>
            <p class="invoice-settings-hint">
              Used on the "Export PDF" invoices below — your details, who it's billed to, and the next invoice number.
            </p>
            <form id="invoiceSettingsForm">
              <label class="invoice-field">
                <span>Your name</span>
                <input type="text" id="invoiceFromName" value={invoiceSettings.fromName} required />
              </label>
              <label class="invoice-field">
                <span>Your address (one line each)</span>
                <textarea id="invoiceFromAddress" rows="4">{invoiceSettings.fromAddress.join('\n')}</textarea>
              </label>
              <label class="invoice-field">
                <span>VAT note</span>
                <input type="text" id="invoiceVatNote" value={invoiceSettings.vatNote} />
              </label>
              <label class="invoice-field">
                <span>Bill to (one line each)</span>
                <textarea id="invoiceBillTo" rows="4">{invoiceSettings.billTo.join('\n')}</textarea>
              </label>
              <label class="invoice-field invoice-field--narrow">
                <span>Next invoice ref</span>
                <input type="number" id="invoiceNextRef" min="1" step="1" value={invoiceSettings.nextInvoiceRef} required />
              </label>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save details</button>
                <span class="invoice-settings-status" id="invoiceSettingsStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <footer class="foot">
          <a class="foot-download" href="/api/tandem-export.csv" download>Download full tandem log (.csv)</a>
        </footer>
      </div>

      <div class="modal-overlay" id="tandemNameModal" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="tandemNameModalTitle">
          <h2 class="modal-title" id="tandemNameModalTitle">Customer name</h2>
          <p class="modal-subtitle" id="tandemNameModalSubtitle">&nbsp;</p>
          <form id="tandemNameForm">
            <input
              type="text"
              id="tandemNameInput"
              class="modal-input"
              placeholder="e.g. Jane Smith"
              autocomplete="off"
              maxlength="80"
              required
            />
            <div class="modal-actions">
              <button type="button" class="modal-cancel" id="tandemNameCancel">Cancel</button>
              <button type="submit" class="modal-confirm">Add jump</button>
            </div>
          </form>
        </div>
      </div>

      {
        showLogout && (
          <footer class="foot foot-global">
            <form class="foot-logout" method="POST" action="/api/logout">
              <button type="submit">Log out</button>
            </form>
          </footer>
        )
      }
    </div>

    <style>
      /*
       * Palette lifted from a Dolomites lake photo: pale sky/water for the
       * canvas, with the mountain, tree-line and deep-water tones from the
       * shot doing the accenting — same relationship as the photo itself
       * (light backdrop, dark forms in front of it).
       */
      :root {
        --canvas: #e9f3f6;
        --panel: #f6fafb;
        --ink: #14202b;
        --ink-soft: #4c6575;
        --line: #d3e1e8;
        --line-strong: #a9c2ce;
        --gold: #2185b6;

        --tandem: #122c41;
        --tandem-soft: #dbe3e9;
        --instructor: #08445b;
        --instructor-soft: #d3e3e8;
        --student: #035042;
        --student-soft: #d6e8e3;
        --sport: #2e647a;
        --sport-soft: #dee7eb;
        --videographer: #6b4f8a;
        --videographer-soft: #e3ddec;

        /* Kept off the main palette on purpose — red still reads as "delete"
           regardless of the rest of the theme. */
        --danger: #b3423a;
        --danger-soft: #f1dedc;

        --radius: 14px;
        --shadow: 0 1px 0 rgba(20, 32, 43, 0.05), 0 6px 16px -8px rgba(20, 32, 43, 0.22);

        color-scheme: light;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --canvas: #0b1620;
          --panel: #13232f;
          --ink: #dceaf0;
          --ink-soft: #8ca7b5;
          --line: #223444;
          --line-strong: #34495b;
          --gold: #4fb6e0;

          --tandem: #3c6e96;
          --tandem-soft: #1b2c3a;
          --instructor: #2e8caf;
          --instructor-soft: #16303b;
          --student: #1e9678;
          --student-soft: #123328;
          --sport: #6398b2;
          --sport-soft: #22333d;
          --videographer: #a186c9;
          --videographer-soft: #2a2337;

          --danger: #d6685f;
          --danger-soft: #3a211f;

          color-scheme: dark;
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 560px;
        margin: 0 auto;
        padding: 20px 16px calc(40px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        gap: 22px;
      }

      /* ---- Masthead ---- */

      .masthead {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .stamp {
        align-self: flex-start;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px 16px;
        border: 2px dashed var(--line-strong);
        border-radius: 10px;
        transform: rotate(-1.5deg);
        color: var(--ink);
      }

      .stamp-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
      }

      .stamp-date {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 19px;
        letter-spacing: -0.01em;
      }

      .totals {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 18px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .totals-block {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .totals-value {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 34px;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--gold);
        font-variant-numeric: tabular-nums;
      }

      .totals-value--packs {
        color: var(--ink);
      }

      .totals-label {
        font-size: 12px;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .totals-divider {
        width: 1px;
        align-self: stretch;
        background: var(--line);
      }

      .totals-block--packs {
        flex: 1;
      }

      /* ---- Category cards ---- */

      .categories {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 14px 16px 16px;
        box-shadow: var(--shadow);
        border-left: 5px solid var(--accent, var(--line-strong));
      }

      .card[data-category='tandem'] {
        --accent: var(--tandem);
      }
      .card[data-category='instructor'],
      .card[data-tandem-category='instructor'] {
        --accent: var(--instructor);
      }
      .card[data-category='student'] {
        --accent: var(--student);
      }
      .card[data-category='sport'] {
        --accent: var(--sport);
      }
      .card[data-tandem-category='videographer'] {
        --accent: var(--videographer);
      }

      .card-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
      }

      .card-label {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .card-rate {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--ink-soft);
      }

      .card-controls {
        display: grid;
        grid-template-columns: 64px 1fr 64px;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
      }

      .stepper {
        appearance: none;
        border: none;
        border-radius: 12px;
        width: 100%;
        height: 56px;
        font-size: 28px;
        line-height: 1;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        color: #fff;
        background: var(--accent);
        cursor: pointer;
        touch-action: manipulation;
        transition: transform 0.08s ease, filter 0.08s ease;
      }

      .stepper--minus {
        background: transparent;
        color: var(--accent);
        border: 2px solid var(--accent);
      }

      .stepper:active {
        transform: scale(0.93);
        filter: brightness(0.95);
      }

      .stepper:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 2px;
      }

      .card-count {
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 40px;
        font-variant-numeric: tabular-nums;
        transition: transform 0.12s ease;
      }

      .card-count.bump {
        transform: scale(1.18);
      }

      .card-subtotal {
        margin-top: 8px;
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: var(--ink-soft);
      }

      /* ---- History ---- */

      .history {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }

      .history-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        border: none;
        padding: 14px 16px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 15px;
        color: var(--ink);
        cursor: pointer;
      }

      .history-toggle-icon {
        transition: transform 0.15s ease;
        font-size: 20px;
        color: var(--ink-soft);
      }

      .history-toggle[aria-expanded='true'] .history-toggle-icon {
        transform: rotate(90deg);
      }

      .history-panel {
        border-top: 1px solid var(--line);
        padding: 4px 0 8px;
      }

      .history-tabs {
        display: flex;
        gap: 6px;
        padding: 10px 16px 6px;
      }

      .history-tab {
        appearance: none;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 12.5px;
        padding: 6px 12px;
        border-radius: 999px;
        cursor: pointer;
      }

      .history-tab[aria-selected='true'] {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--canvas);
      }

      /*
       * :global() throughout this block because the Week/Month tables are
       * rendered by AggregateTable.astro / TandemAggregateTable.astro,
       * separate components with their own Astro CSS scope — plain class
       * selectors here would only ever match the Day table, which lives
       * directly in this file.
       */
      :global(.history-empty) {
        margin: 0;
        padding: 14px 16px;
        color: var(--ink-soft);
        font-size: 14px;
      }

      :global(.history-scroll) {
        overflow-x: auto;
        padding: 0 8px;
      }

      :global(.history-table) {
        width: 100%;
        border-collapse: collapse;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        white-space: nowrap;
      }

      :global(.history-table th),
      :global(.history-table td) {
        padding: 8px 8px;
        text-align: right;
      }

      :global(.history-table th:first-child),
      :global(.history-table td:first-child) {
        text-align: left;
      }

      :global(.history-table thead th) {
        color: var(--ink-soft);
        font-weight: 600;
        border-bottom: 1px solid var(--line);
      }

      :global(.history-table tbody tr:not(:last-child) td) {
        border-bottom: 1px solid var(--line);
      }

      :global(.th-tandem),
      :global(.td-tandem) {
        color: var(--tandem);
      }
      :global(.th-instructor),
      :global(.td-instructor) {
        color: var(--instructor);
      }
      :global(.th-student),
      :global(.td-student) {
        color: var(--student);
      }
      :global(.th-sport),
      :global(.td-sport) {
        color: var(--sport);
      }
      :global(.th-videographer),
      :global(.td-videographer) {
        color: var(--videographer);
      }

      /* ---- Tandem jump list ---- */

      .tandem-add {
        appearance: none;
        border: none;
        border-radius: 12px;
        width: 100%;
        height: 46px;
        margin-top: 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 14.5px;
        color: #fff;
        background: var(--accent);
        cursor: pointer;
        touch-action: manipulation;
        transition: transform 0.08s ease, filter 0.08s ease;
      }

      .tandem-add:active {
        transform: scale(0.97);
        filter: brightness(0.95);
      }

      .tandem-add:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 2px;
      }

      .tandem-jump-list {
        list-style: none;
        margin: 4px 0 0;
        padding: 0;
      }

      /*
       * :global() here (and below) because the list is re-rendered
       * client-side via innerHTML after each add/delete — Astro only
       * auto-scopes elements it renders itself, not ones a script injects.
       */
      :global(.tandem-jump-row) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 9px 2px;
        border-top: 1px solid var(--line);
        font-size: 13.5px;
      }

      :global(.tandem-jump-name) {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      :global(.tandem-jump-delete) {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        line-height: 1;
        width: 26px;
        height: 26px;
        flex: none;
        border-radius: 8px;
        cursor: pointer;
        touch-action: manipulation;
      }

      :global(.tandem-jump-delete:hover),
      :global(.tandem-jump-delete:focus-visible) {
        background: var(--danger-soft);
        color: var(--danger);
        outline: none;
      }

      :global(.tandem-jump-empty) {
        margin: 0;
        padding: 9px 2px;
        border-top: 1px solid var(--line);
        color: var(--ink-soft);
        font-size: 13px;
      }

      /* ---- Customer-name modal ---- */

      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 22, 32, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        z-index: 20;
      }

      .modal-overlay[hidden] {
        display: none;
      }

      .modal {
        width: 100%;
        max-width: 400px;
        background: var(--panel);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 20px;
      }

      .modal-title {
        margin: 0 0 2px;
        font-size: 17px;
        font-weight: 700;
      }

      .modal-subtitle {
        margin: 0 0 14px;
        font-size: 13px;
        color: var(--ink-soft);
      }

      .modal-input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid var(--line-strong);
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        font-size: 16px;
      }

      .modal-input:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 1px;
      }

      .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 14px;
      }

      .modal-cancel,
      .modal-confirm {
        flex: 1;
        appearance: none;
        border: none;
        border-radius: 10px;
        height: 46px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        touch-action: manipulation;
      }

      .modal-cancel {
        background: transparent;
        border: 1px solid var(--line-strong);
        color: var(--ink-soft);
      }

      .modal-confirm {
        background: var(--gold);
        color: #fff;
      }

      .modal-confirm:disabled {
        opacity: 0.6;
        cursor: default;
      }

      /* ---- Invoice settings ---- */

      .invoice-settings-panel {
        padding: 14px 16px 16px;
      }

      .invoice-settings-hint {
        margin: 0 0 14px;
        font-size: 12.5px;
        color: var(--ink-soft);
      }

      .invoice-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ink-soft);
      }

      .invoice-field--narrow {
        max-width: 160px;
      }

      .invoice-field input,
      .invoice-field textarea {
        width: 100%;
        padding: 9px 12px;
        border-radius: 10px;
        border: 1px solid var(--line-strong);
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 400;
        resize: vertical;
      }

      .invoice-field input:focus-visible,
      .invoice-field textarea:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 1px;
      }

      .invoice-settings-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 4px;
      }

      .invoice-settings-save {
        appearance: none;
        border: none;
        border-radius: 10px;
        height: 42px;
        padding: 0 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #fff;
        background: var(--gold);
        cursor: pointer;
        touch-action: manipulation;
      }

      .invoice-settings-save:disabled {
        opacity: 0.6;
        cursor: default;
      }

      .invoice-settings-status {
        font-size: 12.5px;
        color: var(--ink-soft);
      }

      .invoice-settings-status[data-state='ok'] {
        color: var(--student);
      }

      .invoice-settings-status[data-state='error'] {
        color: var(--danger);
      }

      /* ---- Footer ---- */

      .foot {
        text-align: center;
      }

      .foot-download {
        display: inline-block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--gold);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }

      .foot-logout {
        margin-top: 10px;
      }

      .foot-logout button {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        font-family: inherit;
        font-size: 12.5px;
        cursor: pointer;
        padding: 0;
      }

      .foot-logout button:hover {
        color: var(--danger);
      }

      @media (min-width: 480px) {
        .categories {
          gap: 14px;
        }
      }

      /* ---- App-level tabs ---- */

      .app-tabs,
      .sub-tabs {
        display: flex;
        gap: 8px;
      }

      .sub-tabs {
        margin-bottom: 2px;
      }

      .app-tab,
      .sub-tab {
        flex: 1;
        appearance: none;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: 14px;
        padding: 10px;
        border-radius: 10px;
        cursor: pointer;
      }

      .app-tab[aria-selected='true'],
      .sub-tab[aria-selected='true'] {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--canvas);
      }

      .app-view,
      .sub-view {
        display: flex;
        flex-direction: column;
        gap: 22px;
      }

      .app-view[hidden],
      .sub-view[hidden] {
        display: none;
      }

      /* ---- Timer ---- */

      .timer {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
      }

      .timer-display {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 64px;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
      }

      .timer-button {
        appearance: none;
        border: none;
        width: 100%;
        max-width: 280px;
        height: 64px;
        border-radius: 999px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: #fff;
        background: var(--student);
        cursor: pointer;
        touch-action: manipulation;
        transition: transform 0.08s ease, filter 0.08s ease;
      }

      .timer-button:active {
        transform: scale(0.96);
      }

      .timer-button:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 2px;
      }

      .timer-button[data-running='true'] {
        background: var(--danger);
      }

      /* ---- Fastest 5 board ---- */

      .fastest {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 14px 16px 6px;
      }

      .fastest-title {
        margin: 0 0 10px;
        font-size: 15px;
        font-weight: 700;
      }

      /*
       * :global() here because the board is re-rendered client-side via
       * innerHTML after each timed pack job — Astro only auto-scopes
       * elements it renders itself, not ones a script injects later.
       */
      :global(.fastest-list) {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      :global(.fastest-row) {
        display: grid;
        grid-template-columns: 22px auto 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 6px 0;
        border-top: 1px solid var(--line);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
      }

      :global(.fastest-row.is-first) {
        color: var(--gold);
      }

      :global(.fastest-rank) {
        color: var(--ink-soft);
        font-size: 12px;
      }

      :global(.fastest-row.is-first .fastest-rank) {
        color: var(--gold);
      }

      :global(.fastest-duration) {
        font-weight: 600;
        font-size: 16px;
      }

      :global(.fastest-when) {
        text-align: right;
        color: var(--ink-soft);
        font-size: 12px;
      }

      :global(.fastest-row.is-first .fastest-when) {
        color: inherit;
        opacity: 0.8;
      }

      :global(.fastest-delete) {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-size: 20px;
        line-height: 1;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        cursor: pointer;
        touch-action: manipulation;
      }

      :global(.fastest-delete:hover),
      :global(.fastest-delete:focus-visible) {
        background: var(--danger-soft);
        color: var(--danger);
        outline: none;
      }

      :global(.fastest-delete:active) {
        transform: scale(0.9);
      }

      :global(.fastest-empty) {
        margin: 0;
        padding: 10px 0 14px;
        color: var(--ink-soft);
        font-size: 14px;
      }
    </style>

    <script>
      import { formatDuration, formatWhen } from '../lib/format';

      const RATES: Record<string, number> = {
        tandem: 11,
        instructor: 6.5,
        student: 6.5,
        sport: 6.5,
      };

      const TANDEM_RATES: Record<string, number> = {
        instructor: 42,
        videographer: 42,
      };

      function money(n: number) {
        return `£${n.toFixed(2)}`;
      }

      // ---- Generic tab-group wiring, reused for the app-level Packing /
      // Tandems tabs, the Pack / Timer sub-tabs, and each section's own
      // Day / Week / Month history tabs. Scoped to `root` so that two
      // independent tab groups can reuse the same class names/data
      // attributes without cross-wiring each other's visibility.
      function wireTabGroup(root: ParentNode, tabSelector: string, viewSelector: string, tabAttr: string, viewAttr: string) {
        const tabs = root.querySelectorAll<HTMLButtonElement>(tabSelector);
        const views = root.querySelectorAll<HTMLElement>(viewSelector);
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
            views.forEach((view) => {
              view.hidden = view.dataset[viewAttr] !== tab.dataset[tabAttr];
            });
          });
        });
      }

      function wireToggle(toggleId: string, panelId: string) {
        const toggle = document.getElementById(toggleId);
        const panel = document.getElementById(panelId);
        toggle?.addEventListener('click', () => {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          if (panel) panel.hidden = expanded;
        });
      }

      wireTabGroup(document, '.app-tab', '.app-view', 'appTab', 'appView');

      const packingView = document.getElementById('packingView');
      if (packingView) wireTabGroup(packingView, '.sub-tab', '.sub-view', 'subTab', 'subView');

      const historyPanel = document.getElementById('historyPanel');
      if (historyPanel) wireTabGroup(historyPanel, '.history-tab', '.history-view', 'tab', 'view');
      wireToggle('historyToggle', 'historyPanel');

      const tandemHistoryPanel = document.getElementById('tandemHistoryPanel');
      if (tandemHistoryPanel) wireTabGroup(tandemHistoryPanel, '.history-tab', '.history-view', 'tab', 'view');
      wireToggle('tandemHistoryToggle', 'tandemHistoryPanel');

      wireToggle('invoiceSettingsToggle', 'invoiceSettingsPanel');

      function bump(el: Element | null) {
        if (!el) return;
        el.classList.remove('bump');
        // Force reflow so the animation can restart on rapid taps.
        void (el as HTMLElement).offsetWidth;
        el.classList.add('bump');
      }

      // ---- Packing counters ----

      async function adjust(category: string, delta: number) {
        const res = await fetch('/api/adjust', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category, delta }),
        });
        if (!res.ok) {
          console.error('Failed to save pack job', await res.text());
          return;
        }
        const data = await res.json();
        applyState(data.state.counts, data.totalPacks, data.totalEarnings);
        if (data.currentWeek) applyAggregate('week', data.currentWeek);
        if (data.currentMonth) applyAggregate('month', data.currentMonth);
        bump(document.querySelector(`[data-count="${category}"]`));
      }

      function applyState(counts: Record<string, number>, packs: number, earnings: number) {
        for (const category of Object.keys(counts)) {
          const countEl = document.querySelector(`[data-count="${category}"]`);
          const subtotalEl = document.querySelector(`[data-subtotal="${category}"]`);
          if (countEl) countEl.textContent = String(counts[category]);
          if (subtotalEl) subtotalEl.textContent = money(counts[category] * RATES[category]);
        }
        const totalPacksEl = document.getElementById('totalPacks');
        const totalEarningsEl = document.getElementById('totalEarnings');
        if (totalPacksEl) totalPacksEl.textContent = String(packs);
        if (totalEarningsEl) totalEarningsEl.textContent = money(earnings);
      }

      interface Aggregate {
        counts: Record<string, number>;
        totalPacks?: number;
        totalJumps?: number;
        totalEarnings: number;
      }

      // Keeps the "this week" / "this invoice month" row's numbers current
      // as taps land, without re-rendering the whole history table.
      function applyAggregate(prefix: 'week' | 'month', agg: Aggregate) {
        for (const category of Object.keys(agg.counts)) {
          const cell = document.querySelector(`[data-agg-count="${prefix}:${category}"]`);
          if (cell) cell.textContent = String(agg.counts[category]);
        }
        const packsCell = document.querySelector(`[data-agg-total="${prefix}:packs"]`);
        const earningsCell = document.querySelector(`[data-agg-total="${prefix}:earnings"]`);
        if (packsCell) packsCell.textContent = String(agg.totalPacks);
        if (earningsCell) earningsCell.textContent = money(agg.totalEarnings);
      }

      document.querySelectorAll<HTMLButtonElement>('.stepper[data-category]').forEach((button) => {
        button.addEventListener('click', () => {
          const category = button.dataset.category!;
          const delta = button.dataset.action === 'increment' ? 1 : -1;
          button.disabled = true;
          adjust(category, delta).finally(() => {
            button.disabled = false;
          });
        });
      });

      // ---- Tandem jump log ----
      //
      // Every tandem jump is credited to a customer, so adding one prompts
      // for a name via a small modal rather than just bumping a count.

      const TANDEM_CATEGORY_LABELS: Record<string, string> = {
        instructor: 'Instructor',
        videographer: 'Videographer',
      };

      interface Jump {
        name: string;
        at: string;
      }

      interface TandemState {
        counts: Record<string, number>;
        entries: Record<string, Jump[]>;
      }

      function escapeHtml(s: string): string {
        return s.replace(
          /[&<>"']/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
        );
      }

      function renderTandemList(category: string, entries: Jump[]) {
        const list = document.querySelector(`[data-tandem-list="${category}"]`);
        if (!list) return;
        if (entries.length === 0) {
          list.innerHTML = '<li class="tandem-jump-empty">No jumps logged yet today.</li>';
          return;
        }
        list.innerHTML = entries
          .map(
            (j) => `
              <li class="tandem-jump-row" data-at="${j.at}">
                <span class="tandem-jump-name">${escapeHtml(j.name)}</span>
                <button type="button" class="tandem-jump-delete" data-at="${j.at}" aria-label="Remove ${escapeHtml(j.name)}">&times;</button>
              </li>`,
          )
          .join('');
      }

      function applyTandemState(state: TandemState, jumps: number, earnings: number) {
        for (const category of Object.keys(state.counts)) {
          renderTandemList(category, state.entries[category] ?? []);
          const subtotalEl = document.querySelector(`[data-tandem-subtotal="${category}"]`);
          if (subtotalEl) subtotalEl.textContent = money(state.counts[category] * TANDEM_RATES[category]);
        }
        const totalJumpsEl = document.getElementById('tandemTotalJumps');
        const totalEarningsEl = document.getElementById('tandemTotalEarnings');
        if (totalJumpsEl) totalJumpsEl.textContent = String(jumps);
        if (totalEarningsEl) totalEarningsEl.textContent = money(earnings);
      }

      function applyTandemAggregate(prefix: 'tweek' | 'tmonth', agg: Aggregate) {
        for (const category of Object.keys(agg.counts)) {
          const cell = document.querySelector(`[data-agg-count="${prefix}:${category}"]`);
          if (cell) cell.textContent = String(agg.counts[category]);
        }
        const jumpsCell = document.querySelector(`[data-agg-total="${prefix}:jumps"]`);
        const earningsCell = document.querySelector(`[data-agg-total="${prefix}:earnings"]`);
        if (jumpsCell) jumpsCell.textContent = String(agg.totalJumps);
        if (earningsCell) earningsCell.textContent = money(agg.totalEarnings);
      }

      async function addTandemJump(category: string, name: string) {
        const res = await fetch('/api/tandem-adjust', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category, name }),
        });
        if (!res.ok) {
          console.error('Failed to save tandem jump', await res.text());
          return;
        }
        const data = await res.json();
        applyTandemState(data.state, data.totalJumps, data.totalEarnings);
        if (data.currentWeek) applyTandemAggregate('tweek', data.currentWeek);
        if (data.currentMonth) applyTandemAggregate('tmonth', data.currentMonth);
      }

      async function deleteTandemJump(at: string) {
        try {
          const res = await fetch('/api/tandem-adjust', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ at }),
          });
          if (!res.ok) return;
          const data = await res.json();
          applyTandemState(data.state, data.totalJumps, data.totalEarnings);
          if (data.currentWeek) applyTandemAggregate('tweek', data.currentWeek);
          if (data.currentMonth) applyTandemAggregate('tmonth', data.currentMonth);
        } catch (err) {
          console.error('Failed to delete tandem jump', err);
        }
      }

      document.querySelectorAll<HTMLElement>('[data-tandem-list]').forEach((list) => {
        list.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.tandem-jump-delete');
          if (!button?.dataset.at) return;
          void deleteTandemJump(button.dataset.at);
        });
      });

      // ---- Customer-name modal ----

      let pendingCategory: string | null = null;

      const nameModal = document.getElementById('tandemNameModal');
      const nameModalSubtitle = document.getElementById('tandemNameModalSubtitle');
      const nameForm = document.getElementById('tandemNameForm') as HTMLFormElement | null;
      const nameInput = document.getElementById('tandemNameInput') as HTMLInputElement | null;
      const nameCancel = document.getElementById('tandemNameCancel');

      function openNameModal(category: string) {
        pendingCategory = category;
        if (nameModalSubtitle) {
          nameModalSubtitle.textContent = `${TANDEM_CATEGORY_LABELS[category] ?? category} jump — ${money(TANDEM_RATES[category])}`;
        }
        if (nameInput) nameInput.value = '';
        if (nameModal) nameModal.hidden = false;
        nameInput?.focus();
      }

      function closeNameModal() {
        pendingCategory = null;
        if (nameModal) nameModal.hidden = true;
      }

      document.querySelectorAll<HTMLButtonElement>('[data-tandem-add]').forEach((button) => {
        button.addEventListener('click', () => openNameModal(button.dataset.tandemAdd!));
      });

      nameCancel?.addEventListener('click', closeNameModal);
      nameModal?.addEventListener('click', (event) => {
        if (event.target === nameModal) closeNameModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nameModal && !nameModal.hidden) closeNameModal();
      });

      nameForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const name = nameInput?.value.trim();
        const category = pendingCategory;
        if (!name || !category) return;
        const submitButton = nameForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
        addTandemJump(category, name)
          .then(() => closeNameModal())
          .finally(() => {
            if (submitButton) submitButton.disabled = false;
          });
      });

      // ---- Invoice settings ----

      const invoiceSettingsForm = document.getElementById('invoiceSettingsForm') as HTMLFormElement | null;
      const invoiceSettingsStatus = document.getElementById('invoiceSettingsStatus');

      invoiceSettingsForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const fromName = (document.getElementById('invoiceFromName') as HTMLInputElement | null)?.value ?? '';
        const fromAddress = (document.getElementById('invoiceFromAddress') as HTMLTextAreaElement | null)?.value ?? '';
        const vatNote = (document.getElementById('invoiceVatNote') as HTMLInputElement | null)?.value ?? '';
        const billTo = (document.getElementById('invoiceBillTo') as HTMLTextAreaElement | null)?.value ?? '';
        const nextInvoiceRef = Number(
          (document.getElementById('invoiceNextRef') as HTMLInputElement | null)?.value ?? '',
        );

        const submitButton = invoiceSettingsForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
        if (invoiceSettingsStatus) {
          invoiceSettingsStatus.textContent = 'Saving…';
          invoiceSettingsStatus.removeAttribute('data-state');
        }

        try {
          const res = await fetch('/api/invoice-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fromName, fromAddress, vatNote, billTo, nextInvoiceRef }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => null);
            throw new Error(data?.error ?? 'Failed to save');
          }
          if (invoiceSettingsStatus) {
            invoiceSettingsStatus.textContent = 'Saved';
            invoiceSettingsStatus.dataset.state = 'ok';
          }
        } catch (err) {
          console.error('Failed to save invoice settings', err);
          if (invoiceSettingsStatus) {
            invoiceSettingsStatus.textContent = err instanceof Error ? err.message : 'Failed to save';
            invoiceSettingsStatus.dataset.state = 'error';
          }
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      });

      // ---- Stopwatch ----

      const timerButton = document.getElementById('timerButton') as HTMLButtonElement | null;
      const timerDisplay = document.getElementById('timerDisplay');
      let timerHandle: number | undefined;
      let startedAt = 0;

      function renderElapsed() {
        if (timerDisplay) timerDisplay.textContent = formatDuration(Date.now() - startedAt);
      }

      interface PackTime {
        ms: number;
        at: string;
      }

      function renderFastestBoard(top5: PackTime[]) {
        const board = document.getElementById('fastestBoard');
        if (!board) return;
        if (top5.length === 0) {
          board.innerHTML = '<p class="fastest-empty">Time a pack job to start the board.</p>';
          return;
        }
        const rows = top5
          .map(
            (t, i) => `
              <li class="fastest-row${i === 0 ? ' is-first' : ''}">
                <span class="fastest-rank">${i + 1}</span>
                <span class="fastest-duration">${formatDuration(t.ms)}</span>
                <span class="fastest-when">${formatWhen(t.at)}</span>
                <button type="button" class="fastest-delete" data-at="${t.at}" aria-label="Delete the ${formatDuration(t.ms)} time">&times;</button>
              </li>`,
          )
          .join('');
        board.innerHTML = `<ol class="fastest-list">${rows}</ol>`;
      }

      async function savePackTime(ms: number) {
        try {
          const res = await fetch('/api/pack-time', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ms }),
          });
          if (!res.ok) return;
          const data = await res.json();
          renderFastestBoard(data.top5);
        } catch (err) {
          console.error('Failed to save pack time', err);
        }
      }

      async function deletePackTime(at: string) {
        try {
          const res = await fetch('/api/pack-time', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ at }),
          });
          if (!res.ok) return;
          const data = await res.json();
          renderFastestBoard(data.top5);
        } catch (err) {
          console.error('Failed to delete pack time', err);
        }
      }

      // Delegated so it keeps working after renderFastestBoard() replaces
      // the rows' innerHTML.
      document.getElementById('fastestBoard')?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.fastest-delete');
        if (!button?.dataset.at) return;
        void deletePackTime(button.dataset.at);
      });

      timerButton?.addEventListener('click', () => {
        const running = timerButton.dataset.running === 'true';
        if (!running) {
          startedAt = Date.now();
          timerButton.dataset.running = 'true';
          timerButton.textContent = 'Stop';
          renderElapsed();
          timerHandle = window.setInterval(renderElapsed, 100);
        } else {
          window.clearInterval(timerHandle);
          const elapsed = Date.now() - startedAt;
          timerButton.dataset.running = 'false';
          timerButton.textContent = 'Start';
          if (timerDisplay) timerDisplay.textContent = '0:00.0';
          void savePackTime(elapsed);
        }
      });
    </script>
  </body>
</html>
