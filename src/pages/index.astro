---
import {
  CATEGORIES,
  CATEGORY_LABELS,
  RATES,
  loadTodayState,
  readHistory,
  toHistoryRow,
  totalEarnings,
  totalPacks,
} from '../lib/packing';
import { groupByInvoiceMonth, groupByWeek } from '../lib/invoice';
import {
  CATEGORIES as TANDEM_CATEGORIES,
  CATEGORY_LABELS as TANDEM_CATEGORY_LABELS,
  RATES as TANDEM_RATES,
  loadTodayState as loadTodayTandemState,
  readHistory as readTandemHistory,
  toHistoryRow as toTandemHistoryRow,
  totalEarnings as totalTandemEarnings,
  totalJumps,
} from '../lib/tandem';
import { groupByInvoiceMonth as groupTandemByInvoiceMonth, groupByWeek as groupTandemByWeek } from '../lib/tandem-invoice';
import { readInvoiceSettings } from '../lib/invoice-settings';
import { readLogbook, nextJumpNumber } from '../lib/logbook';
import { readLogbookSettings } from '../lib/logbook-settings';
import { formatDuration, formatWhen } from '../lib/format';
import { readFastestFive } from '../lib/times';
import { authEnabled } from '../lib/auth';
import AggregateTable from '../components/AggregateTable.astro';
import TandemAggregateTable from '../components/TandemAggregateTable.astro';

const state = await loadTodayState();
const topTimes = await readFastestFive();
const showLogout = authEnabled();

// A wider window of history feeds the week/month rollups; the day-by-day
// table only shows the most recent slice of it.
const fullHistory = await readHistory(400);
const dayRows = fullHistory.slice(0, 14);

// Today isn't in the CSV-backed history yet (it's still being logged), but
// it belongs in this week's and this invoice month's running totals.
const combined = [...fullHistory, toHistoryRow(state)];
const weekRows = groupByWeek(combined).slice(0, 12);
const monthRows = groupByInvoiceMonth(combined).slice(0, 12);

// Same shape again, for the separate tandem-jump log.
const tandemState = await loadTodayTandemState();
const tandemFullHistory = await readTandemHistory(400);
const tandemDayRows = tandemFullHistory.slice(0, 14);
const tandemCombined = [...tandemFullHistory, toTandemHistoryRow(tandemState)];
const tandemWeekRows = groupTandemByWeek(tandemCombined).slice(0, 12);
const tandemMonthRows = groupTandemByInvoiceMonth(tandemCombined).slice(0, 12);

const invoiceSettings = await readInvoiceSettings();

// The personal jump logbook — a separate ledger again, numbered from a
// configurable starting offset rather than a running daily count.
const logbookSettings = await readLogbookSettings();
const logbookEntries = await readLogbook(logbookSettings.baseJumps);
const nextLogbookNumber = await nextJumpNumber(logbookSettings.baseJumps);

const dateObj = new Date(`${state.date}T00:00:00`);
const dateDisplay = dateObj.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
});

const money = (n: number) => `£${n.toFixed(2)}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#122c41" />
    <meta name="generator" content={Astro.generator} />
    <title>Packing Log</title>
    <meta name="description" content="Daily pack job and tandem jump counter and earnings log for a skydive rigger." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <div class="app-tabs" role="tablist" aria-label="Section">
        <button type="button" class="app-tab" data-app-tab="packing" role="tab" aria-selected="true">Packing</button>
        <button type="button" class="app-tab" data-app-tab="tandems" role="tab" aria-selected="false">Tandems</button>
        <button type="button" class="app-tab" data-app-tab="logbook" role="tab" aria-selected="false">Logbook</button>
      </div>

      <div class="app-view" data-app-view="packing" id="packingView">
        <div class="sub-tabs" role="tablist" aria-label="Packing view">
          <button type="button" class="sub-tab" data-sub-tab="pack" role="tab" aria-selected="true">Pack</button>
          <button type="button" class="sub-tab" data-sub-tab="timer" role="tab" aria-selected="false">Timer</button>
        </div>

        <div class="sub-view" data-sub-view="pack">
          <header class="masthead">
            <div class="stamp" aria-hidden="false">
              <span class="stamp-label">Manifest</span>
              <span class="stamp-date" id="dateDisplay">{dateDisplay}</span>
            </div>
            <div class="totals">
              <div class="totals-block">
                <span class="totals-value" id="totalEarnings">{money(totalEarnings(state.counts))}</span>
                <span class="totals-label">earned today</span>
              </div>
              <div class="totals-divider" aria-hidden="true"></div>
              <div class="totals-block totals-block--packs">
                <span class="totals-value totals-value--packs" id="totalPacks">{totalPacks(state.counts)}</span>
                <span class="totals-label">packs today</span>
              </div>
            </div>
          </header>

          <main class="categories">
            {
              CATEGORIES.map((category) => (
                <section class="card" data-category={category}>
                  <div class="card-top">
                    <h2 class="card-label">{CATEGORY_LABELS[category]}</h2>
                    <span class="card-rate">£{RATES[category].toFixed(2)} / pack</span>
                  </div>
                  <div class="card-controls">
                    <button
                      class="stepper stepper--minus"
                      type="button"
                      data-action="decrement"
                      data-category={category}
                      aria-label={`Remove one ${CATEGORY_LABELS[category]} pack job`}
                    >
                      &minus;
                    </button>
                    <span class="card-count" data-count={category}>
                      {state.counts[category]}
                    </span>
                    <button
                      class="stepper stepper--plus"
                      type="button"
                      data-action="increment"
                      data-category={category}
                      aria-label={`Add one ${CATEGORY_LABELS[category]} pack job`}
                    >
                      &plus;
                    </button>
                  </div>
                  <div class="card-subtotal" data-subtotal={category}>
                    £{(state.counts[category] * RATES[category]).toFixed(2)}
                  </div>
                </section>
              ))
            }
          </main>

          <section class="history">
            <button class="history-toggle" id="historyToggle" type="button" aria-expanded="false" aria-controls="historyPanel">
              <span>History</span>
              <span class="history-toggle-icon" id="historyToggleIcon">&rsaquo;</span>
            </button>
            <div class="history-panel" id="historyPanel" hidden>
              <div class="history-tabs" role="tablist" aria-label="Group history by">
                <button type="button" class="history-tab" data-tab="day" role="tab" aria-selected="true">Day</button>
                <button type="button" class="history-tab" data-tab="week" role="tab" aria-selected="false">Week</button>
                <button type="button" class="history-tab" data-tab="month" role="tab" aria-selected="false">Month</button>
              </div>

              <div class="history-view" data-view="day">
                {
                  dayRows.length === 0 ? (
                    <p class="history-empty">Nothing logged yet before today.</p>
                  ) : (
                    <div class="history-scroll">
                      <table class="history-table">
                        <thead>
                          <tr>
                            <th scope="col">Date</th>
                            {CATEGORIES.map((c) => (
                              <th scope="col" class={`th-${c}`}>
                                {CATEGORY_LABELS[c].slice(0, 3)}
                              </th>
                            ))}
                            <th scope="col">Packs</th>
                            <th scope="col">Earned</th>
                          </tr>
                        </thead>
                        <tbody>
                          {dayRows.map((row) => (
                            <tr>
                              <td class="history-date">{row.date}</td>
                              {CATEGORIES.map((c) => (
                                <td class={`td-${c}`}>{row.counts[c]}</td>
                              ))}
                              <td>{row.totalPacks}</td>
                              <td>{money(row.totalEarnings)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )
                }
              </div>

              <div class="history-view" data-view="week" hidden>
                <AggregateTable rows={weekRows} currentLabel="This week" prefix="week" />
              </div>

              <div class="history-view" data-view="month" hidden>
                <AggregateTable rows={monthRows} currentLabel="This invoice month" prefix="month" />
              </div>
            </div>
          </section>

          <footer class="foot">
            <button type="button" class="foot-download" data-download="/api/export.csv" data-download-name="packing-log.csv">
              Download full log (.csv)
            </button>
          </footer>
        </div>

        <div class="sub-view" data-sub-view="timer" hidden>
          <div class="timer">
            <div class="timer-display" id="timerDisplay">0:00.0</div>
            <button type="button" class="timer-button" id="timerButton" data-running="false">Start</button>
          </div>

          <section class="fastest">
            <h2 class="fastest-title">Fastest 5</h2>
            <div id="fastestBoard">
              {
                topTimes.length === 0 ? (
                  <p class="fastest-empty">Time a pack job to start the board.</p>
                ) : (
                  <ol class="fastest-list">
                    {topTimes.map((t, i) => (
                      <li class:list={['fastest-row', { 'is-first': i === 0 }]}>
                        <span class="fastest-rank">{i + 1}</span>
                        <span class="fastest-duration">{formatDuration(t.ms)}</span>
                        <span class="fastest-when">{formatWhen(t.at)}</span>
                        <button
                          type="button"
                          class="fastest-delete"
                          data-at={t.at}
                          aria-label={`Delete the ${formatDuration(t.ms)} time`}
                        >
                          &times;
                        </button>
                      </li>
                    ))}
                  </ol>
                )
              }
            </div>
          </section>
        </div>
      </div>

      <div class="app-view" data-app-view="tandems" id="tandemsView" hidden>
        <header class="masthead">
          <div class="stamp" aria-hidden="false">
            <span class="stamp-label">Tandem Log</span>
            <span class="stamp-date">{dateDisplay}</span>
          </div>
          <div class="totals">
            <div class="totals-block">
              <span class="totals-value" id="tandemTotalEarnings">{money(totalTandemEarnings(tandemState.counts))}</span>
              <span class="totals-label">earned today</span>
            </div>
            <div class="totals-divider" aria-hidden="true"></div>
            <div class="totals-block totals-block--packs">
              <span class="totals-value totals-value--packs" id="tandemTotalJumps">{totalJumps(tandemState.counts)}</span>
              <span class="totals-label">jumps today</span>
            </div>
          </div>
        </header>

        <section class="categories">
          {
            TANDEM_CATEGORIES.map((category) => (
              <section class="card" data-tandem-category={category}>
                <div class="card-top">
                  <h2 class="card-label">{TANDEM_CATEGORY_LABELS[category]}</h2>
                  <span class="card-rate">£{TANDEM_RATES[category].toFixed(2)} / jump</span>
                </div>
                <button type="button" class="tandem-add" data-tandem-add={category}>
                  &plus; Add {TANDEM_CATEGORY_LABELS[category].toLowerCase()} jump
                </button>
                <ul class="tandem-jump-list" data-tandem-list={category}>
                  {tandemState.entries[category].length === 0 ? (
                    <li class="tandem-jump-empty">No jumps logged yet today.</li>
                  ) : (
                    tandemState.entries[category].map((jump) => (
                      <li class="tandem-jump-row" data-at={jump.at}>
                        <span class="tandem-jump-name">{jump.name}</span>
                        <button
                          type="button"
                          class="tandem-jump-delete"
                          data-at={jump.at}
                          aria-label={`Remove ${jump.name}`}
                        >
                          &times;
                        </button>
                      </li>
                    ))
                  )}
                </ul>
                <div class="card-subtotal" data-tandem-subtotal={category}>
                  £{(tandemState.counts[category] * TANDEM_RATES[category]).toFixed(2)}
                </div>
              </section>
            ))
          }
        </section>

        <section class="history">
          <button class="history-toggle" id="tandemHistoryToggle" type="button" aria-expanded="false" aria-controls="tandemHistoryPanel">
            <span>History</span>
            <span class="history-toggle-icon" id="tandemHistoryToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel" id="tandemHistoryPanel" hidden>
            <div class="history-tabs" role="tablist" aria-label="Group tandem history by">
              <button type="button" class="history-tab" data-tab="day" role="tab" aria-selected="true">Day</button>
              <button type="button" class="history-tab" data-tab="week" role="tab" aria-selected="false">Week</button>
              <button type="button" class="history-tab" data-tab="month" role="tab" aria-selected="false">Month</button>
            </div>

            <div class="history-view" data-view="day">
              {
                tandemDayRows.length === 0 ? (
                  <p class="history-empty">Nothing logged yet before today.</p>
                ) : (
                  <div class="history-scroll">
                    <table class="history-table">
                      <thead>
                        <tr>
                          <th scope="col">Date</th>
                          {TANDEM_CATEGORIES.map((c) => (
                            <th scope="col" class={`th-${c}`}>
                              {TANDEM_CATEGORY_LABELS[c].slice(0, 3)}
                            </th>
                          ))}
                          <th scope="col">Jumps</th>
                          <th scope="col">Earned</th>
                        </tr>
                      </thead>
                      <tbody>
                        {tandemDayRows.map((row) => (
                          <tr>
                            <td class="history-date">{row.date}</td>
                            {TANDEM_CATEGORIES.map((c) => (
                              <td class={`td-${c}`}>{row.counts[c]}</td>
                            ))}
                            <td>{row.totalJumps}</td>
                            <td>{money(row.totalEarnings)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </div>

            <div class="history-view" data-view="week" hidden>
              <TandemAggregateTable rows={tandemWeekRows} currentLabel="This week" prefix="tweek" />
            </div>

            <div class="history-view" data-view="month" hidden>
              <TandemAggregateTable rows={tandemMonthRows} currentLabel="This invoice month" prefix="tmonth" />
            </div>
          </div>
        </section>

        <section class="history">
          <button
            class="history-toggle"
            id="invoiceSettingsToggle"
            type="button"
            aria-expanded="false"
            aria-controls="invoiceSettingsPanel"
          >
            <span>Invoice details</span>
            <span class="history-toggle-icon" id="invoiceSettingsToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="invoiceSettingsPanel" hidden>
            <p class="invoice-settings-hint">
              Used on the "Export PDF" invoices below — your details, who it's billed to, and the next invoice number.
            </p>
            <form id="invoiceSettingsForm">
              <label class="invoice-field">
                <span>Your name</span>
                <input type="text" id="invoiceFromName" value={invoiceSettings.fromName} required />
              </label>
              <label class="invoice-field">
                <span>Your address (one line each)</span>
                <textarea id="invoiceFromAddress" rows="4">{invoiceSettings.fromAddress.join('\n')}</textarea>
              </label>
              <label class="invoice-field">
                <span>VAT note</span>
                <input type="text" id="invoiceVatNote" value={invoiceSettings.vatNote} />
              </label>
              <label class="invoice-field">
                <span>Bill to (one line each)</span>
                <textarea id="invoiceBillTo" rows="4">{invoiceSettings.billTo.join('\n')}</textarea>
              </label>
              <label class="invoice-field invoice-field--narrow">
                <span>Next invoice ref</span>
                <input type="number" id="invoiceNextRef" min="1" step="1" value={invoiceSettings.nextInvoiceRef} required />
              </label>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save details</button>
                <span class="invoice-settings-status" id="invoiceSettingsStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <footer class="foot">
          <button
            type="button"
            class="foot-download"
            data-download="/api/tandem-export.csv"
            data-download-name="tandem-log.csv"
          >
            Download full tandem log (.csv)
          </button>
        </footer>
      </div>

      <div class="app-view" data-app-view="logbook" id="logbookView" hidden>
        <header class="masthead">
          <div class="stamp" aria-hidden="false">
            <span class="stamp-label">Logbook</span>
            <span class="stamp-date">{dateDisplay}</span>
          </div>
          <div class="totals">
            <div class="totals-block totals-block--packs">
              <span class="totals-value totals-value--packs" id="logbookTotalJumps">{nextLogbookNumber - 1}</span>
              <span class="totals-label">jumps logged</span>
            </div>
          </div>
        </header>

        <section class="logbook-form-card">
          <div class="logbook-form-top">
            <h2 class="logbook-form-title" id="logbookFormTitle">Log a jump</h2>
            <span class="logbook-form-number" id="logbookNextNumber">#{nextLogbookNumber}</span>
          </div>
          <form id="logbookForm">
            <input type="hidden" id="logbookEditingAt" value="" />
            <div class="logbook-form-grid">
              <label class="invoice-field">
                <span>Date *</span>
                <input type="date" id="logbookDate" required value={state.date} />
              </label>
              <label class="invoice-field">
                <span>Place</span>
                <select id="logbookPlace">
                  <option value="" selected={!logbookSettings.defaultPlaceId || undefined}>
                    No place selected
                  </option>
                  {
                    logbookSettings.places.map((p) => (
                      <option value={p.id} selected={p.id === logbookSettings.defaultPlaceId || undefined}>
                        {p.name}
                      </option>
                    ))
                  }
                </select>
              </label>
              <label class="invoice-field">
                <span>Exit altitude</span>
                <input type="text" id="logbookAltitude" placeholder="e.g. 13,000 ft" autocomplete="off" maxlength="120" />
              </label>
              <label class="invoice-field">
                <span>Equipment</span>
                <select id="logbookEquipment">
                  <option value="" data-canopy="" data-container="" data-aad="" selected={!logbookSettings.defaultEquipmentId || undefined}>
                    No equipment selected
                  </option>
                  {
                    logbookSettings.equipment.map((eq) => (
                      <option
                        value={eq.id}
                        data-canopy={eq.canopy}
                        data-container={eq.container}
                        data-aad={eq.aad}
                        selected={eq.id === logbookSettings.defaultEquipmentId || undefined}
                      >
                        {eq.name}
                      </option>
                    ))
                  }
                </select>
              </label>
              <label class="invoice-field">
                <span>Aircraft</span>
                <select id="logbookAircraft">
                  <option value="" selected={!logbookSettings.defaultAircraftId || undefined}>
                    No aircraft selected
                  </option>
                  {
                    logbookSettings.aircraft.map((ac) => (
                      <option value={ac.id} selected={ac.id === logbookSettings.defaultAircraftId || undefined}>
                        {ac.plate}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>
            <label class="invoice-field">
              <span>Description</span>
              <textarea id="logbookDescription" rows="3" placeholder="Freefall, exercises, canopy notes…"></textarea>
            </label>
            <div class="invoice-settings-actions">
              <button type="submit" class="invoice-settings-save" id="logbookSubmit">Log jump</button>
              <button type="button" class="logbook-cancel-edit" id="logbookCancelEdit" hidden>Cancel edit</button>
              <span class="invoice-settings-status" id="logbookFormStatus" role="status"></span>
            </div>
          </form>
        </section>

        <section class="logbook-list-card">
          <ul class="logbook-list" id="logbookList">
            {
              logbookEntries.length === 0 ? (
                <li class="logbook-empty">No jumps logged yet.</li>
              ) : (
                logbookEntries.map((e) => {
                  const shortDate = new Date(`${e.date}T00:00:00`).toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  });
                  return (
                    <li
                      class="logbook-entry"
                      data-at={e.at}
                      data-date={e.date}
                      data-place={e.place}
                      data-altitude={e.exitAltitude}
                      data-aircraft={e.aircraft}
                      data-canopy={e.canopy}
                      data-container={e.container}
                      data-aad={e.aad}
                      data-description={e.description}
                    >
                      <button type="button" class="logbook-row" data-toggle={e.at} aria-expanded="false">
                        <span class="logbook-row-number">#{e.number}</span>
                        <span class="logbook-row-date">{shortDate}</span>
                        <span class="logbook-row-place">{e.place || '—'}</span>
                        <span class="logbook-row-chevron">&rsaquo;</span>
                      </button>
                      <div class="logbook-details" id={`logbookDetails-${e.at}`} hidden>
                        <dl class="logbook-details-grid">
                          <div>
                            <dt>Exit altitude</dt>
                            <dd>{e.exitAltitude || '—'}</dd>
                          </div>
                          <div>
                            <dt>Aircraft</dt>
                            <dd>{e.aircraft || '—'}</dd>
                          </div>
                          <div>
                            <dt>Canopy</dt>
                            <dd>{e.canopy || '—'}</dd>
                          </div>
                          <div>
                            <dt>Container</dt>
                            <dd>{e.container || '—'}</dd>
                          </div>
                          <div>
                            <dt>AAD</dt>
                            <dd>{e.aad || '—'}</dd>
                          </div>
                        </dl>
                        {e.description && <p class="logbook-details-description">{e.description}</p>}
                        <div class="logbook-details-actions">
                          <button type="button" class="logbook-edit" data-edit={e.at}>
                            Edit
                          </button>
                          <button type="button" class="logbook-delete" data-delete={e.at}>
                            Delete
                          </button>
                        </div>
                      </div>
                    </li>
                  );
                })
              )
            }
          </ul>
        </section>

        <section class="history">
          <button class="history-toggle" id="placesToggle" type="button" aria-expanded="false" aria-controls="placesPanel">
            <span>Places</span>
            <span class="history-toggle-icon" id="placesToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="placesPanel" hidden>
            <p class="invoice-settings-hint">The starred one is pre-selected whenever you start a new jump.</p>
            <ul class="equipment-list" id="placesList">
              {
                logbookSettings.places.length === 0 ? (
                  <li class="equipment-empty">No places saved yet.</li>
                ) : (
                  logbookSettings.places.map((p) => (
                    <li class="equipment-row" data-id={p.id}>
                      <div class="equipment-row-text">
                        <span class="equipment-row-name">{p.name}</span>
                      </div>
                      <button
                        type="button"
                        class="default-star"
                        data-default-category="place"
                        data-default-id={p.id}
                        aria-pressed={p.id === logbookSettings.defaultPlaceId ? 'true' : 'false'}
                        aria-label={`Set ${p.name} as the default place`}
                      >
                        &#9733;
                      </button>
                      <button type="button" class="equipment-delete" data-place-delete={p.id} aria-label={`Remove ${p.name}`}>
                        &times;
                      </button>
                    </li>
                  ))
                )
              }
            </ul>
            <form id="placesForm" class="equipment-form">
              <label class="invoice-field">
                <span>Name</span>
                <input type="text" id="placeName" placeholder="e.g. Langar" autocomplete="off" maxlength="80" required />
              </label>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save place</button>
                <span class="invoice-settings-status" id="placesStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <section class="history">
          <button class="history-toggle" id="equipmentToggle" type="button" aria-expanded="false" aria-controls="equipmentPanel">
            <span>Equipment</span>
            <span class="history-toggle-icon" id="equipmentToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="equipmentPanel" hidden>
            <p class="invoice-settings-hint">The starred one is pre-selected whenever you start a new jump.</p>
            <ul class="equipment-list" id="equipmentList">
              {
                logbookSettings.equipment.length === 0 ? (
                  <li class="equipment-empty">No equipment saved yet.</li>
                ) : (
                  logbookSettings.equipment.map((eq) => (
                    <li class="equipment-row" data-id={eq.id}>
                      <div class="equipment-row-text">
                        <span class="equipment-row-name">{eq.name}</span>
                        <span class="equipment-row-detail">
                          {[eq.canopy, eq.container, eq.aad].filter(Boolean).join(' · ') || 'No details saved'}
                        </span>
                      </div>
                      <button
                        type="button"
                        class="default-star"
                        data-default-category="equipment"
                        data-default-id={eq.id}
                        aria-pressed={eq.id === logbookSettings.defaultEquipmentId ? 'true' : 'false'}
                        aria-label={`Set ${eq.name} as the default equipment`}
                      >
                        &#9733;
                      </button>
                      <button type="button" class="equipment-delete" data-equipment-delete={eq.id} aria-label={`Remove ${eq.name}`}>
                        &times;
                      </button>
                    </li>
                  ))
                )
              }
            </ul>
            <form id="equipmentForm" class="equipment-form">
              <label class="invoice-field">
                <span>Name</span>
                <input type="text" id="equipmentName" placeholder="e.g. Main rig" autocomplete="off" maxlength="80" required />
              </label>
              <div class="logbook-form-grid">
                <label class="invoice-field">
                  <span>Canopy</span>
                  <input type="text" id="equipmentCanopy" placeholder="e.g. Sabre2 190" autocomplete="off" maxlength="80" />
                </label>
                <label class="invoice-field">
                  <span>Container</span>
                  <input type="text" id="equipmentContainer" placeholder="e.g. Wings X 190" autocomplete="off" maxlength="80" />
                </label>
                <label class="invoice-field">
                  <span>AAD</span>
                  <input type="text" id="equipmentAad" placeholder="e.g. Cypres 2" autocomplete="off" maxlength="80" />
                </label>
              </div>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save equipment</button>
                <span class="invoice-settings-status" id="equipmentStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <section class="history">
          <button class="history-toggle" id="aircraftToggle" type="button" aria-expanded="false" aria-controls="aircraftPanel">
            <span>Aircraft</span>
            <span class="history-toggle-icon" id="aircraftToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="aircraftPanel" hidden>
            <p class="invoice-settings-hint">The starred one is pre-selected whenever you start a new jump.</p>
            <ul class="equipment-list" id="aircraftList">
              {
                logbookSettings.aircraft.length === 0 ? (
                  <li class="equipment-empty">No aircraft saved yet.</li>
                ) : (
                  logbookSettings.aircraft.map((ac) => (
                    <li class="equipment-row" data-id={ac.id}>
                      <div class="equipment-row-text">
                        <span class="equipment-row-name">{ac.plate}</span>
                      </div>
                      <button
                        type="button"
                        class="default-star"
                        data-default-category="aircraft"
                        data-default-id={ac.id}
                        aria-pressed={ac.id === logbookSettings.defaultAircraftId ? 'true' : 'false'}
                        aria-label={`Set ${ac.plate} as the default aircraft`}
                      >
                        &#9733;
                      </button>
                      <button type="button" class="equipment-delete" data-aircraft-delete={ac.id} aria-label={`Remove ${ac.plate}`}>
                        &times;
                      </button>
                    </li>
                  ))
                )
              }
            </ul>
            <form id="aircraftForm" class="equipment-form">
              <label class="invoice-field invoice-field--narrow">
                <span>Registration</span>
                <input type="text" id="aircraftPlate" placeholder="e.g. G-SDSK" autocomplete="off" maxlength="20" required />
              </label>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save aircraft</button>
                <span class="invoice-settings-status" id="aircraftStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <section class="history">
          <button
            class="history-toggle"
            id="logbookSettingsToggle"
            type="button"
            aria-expanded="false"
            aria-controls="logbookSettingsPanel"
          >
            <span>Settings</span>
            <span class="history-toggle-icon" id="logbookSettingsToggleIcon">&rsaquo;</span>
          </button>
          <div class="history-panel invoice-settings-panel" id="logbookSettingsPanel" hidden>
            <p class="invoice-settings-hint">
              Jumps you logged before using this app — added to the count above so numbering carries on correctly.
            </p>
            <form id="logbookSettingsForm">
              <label class="invoice-field invoice-field--narrow">
                <span>Jumps logged before this app</span>
                <input type="number" id="logbookBaseJumps" min="0" step="1" value={logbookSettings.baseJumps} required />
              </label>
              <div class="invoice-settings-actions">
                <button type="submit" class="invoice-settings-save">Save</button>
                <span class="invoice-settings-status" id="logbookSettingsStatus" role="status"></span>
              </div>
            </form>
          </div>
        </section>

        <footer class="foot">
          <button
            type="button"
            class="foot-download"
            data-download="/api/logbook-export.csv"
            data-download-name="logbook.csv"
          >
            Download full logbook (.csv)
          </button>
        </footer>
      </div>

      <div class="modal-overlay" id="tandemNameModal" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="tandemNameModalTitle">
          <h2 class="modal-title" id="tandemNameModalTitle">Customer name</h2>
          <p class="modal-subtitle" id="tandemNameModalSubtitle">&nbsp;</p>
          <form id="tandemNameForm">
            <input
              type="text"
              id="tandemNameInput"
              class="modal-input"
              placeholder="e.g. Jane Smith"
              autocomplete="off"
              maxlength="80"
              required
            />
            <div class="modal-actions">
              <button type="button" class="modal-cancel" id="tandemNameCancel">Cancel</button>
              <button type="submit" class="modal-confirm">Add jump</button>
            </div>
          </form>
        </div>
      </div>

      {
        showLogout && (
          <footer class="foot foot-global">
            <form class="foot-logout" method="POST" action="/api/logout">
              <button type="submit">Log out</button>
            </form>
          </footer>
        )
      }
    </div>

    <style>
      /*
       * Palette lifted from a Dolomites lake photo: pale sky/water for the
       * canvas, with the mountain, tree-line and deep-water tones from the
       * shot doing the accenting — same relationship as the photo itself
       * (light backdrop, dark forms in front of it).
       */
      :root {
        --canvas: #e9f3f6;
        --panel: #f6fafb;
        --ink: #14202b;
        --ink-soft: #4c6575;
        --line: #d3e1e8;
        --line-strong: #a9c2ce;
        --gold: #2185b6;

        --tandem: #122c41;
        --tandem-soft: #dbe3e9;
        --instructor: #08445b;
        --instructor-soft: #d3e3e8;
        --student: #035042;
        --student-soft: #d6e8e3;
        --sport: #2e647a;
        --sport-soft: #dee7eb;
        --videographer: #6b4f8a;
        --videographer-soft: #e3ddec;

        /* Kept off the main palette on purpose — red still reads as "delete"
           regardless of the rest of the theme. */
        --danger: #b3423a;
        --danger-soft: #f1dedc;

        --radius: 14px;
        --shadow: 0 1px 0 rgba(20, 32, 43, 0.05), 0 6px 16px -8px rgba(20, 32, 43, 0.22);

        color-scheme: light;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --canvas: #0b1620;
          --panel: #13232f;
          --ink: #dceaf0;
          --ink-soft: #8ca7b5;
          --line: #223444;
          --line-strong: #34495b;
          --gold: #4fb6e0;

          --tandem: #3c6e96;
          --tandem-soft: #1b2c3a;
          --instructor: #2e8caf;
          --instructor-soft: #16303b;
          --student: #1e9678;
          --student-soft: #123328;
          --sport: #6398b2;
          --sport-soft: #22333d;
          --videographer: #a186c9;
          --videographer-soft: #2a2337;

          --danger: #d6685f;
          --danger-soft: #3a211f;

          color-scheme: dark;
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 560px;
        margin: 0 auto;
        padding: 20px 16px calc(40px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        gap: 22px;
      }

      /* ---- Masthead ---- */

      .masthead {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .stamp {
        align-self: flex-start;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px 16px;
        border: 2px dashed var(--line-strong);
        border-radius: 10px;
        transform: rotate(-1.5deg);
        color: var(--ink);
      }

      .stamp-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
      }

      .stamp-date {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 19px;
        letter-spacing: -0.01em;
      }

      .totals {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 18px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .totals-block {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .totals-value {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 34px;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--gold);
        font-variant-numeric: tabular-nums;
      }

      .totals-value--packs {
        color: var(--ink);
      }

      .totals-label {
        font-size: 12px;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .totals-divider {
        width: 1px;
        align-self: stretch;
        background: var(--line);
      }

      .totals-block--packs {
        flex: 1;
      }

      /* ---- Category cards ---- */

      .categories {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 14px 16px 16px;
        box-shadow: var(--shadow);
        border-left: 5px solid var(--accent, var(--line-strong));
      }

      .card[data-category='tandem'] {
        --accent: var(--tandem);
      }
      .card[data-category='instructor'],
      .card[data-tandem-category='instructor'] {
        --accent: var(--instructor);
      }
      .card[data-category='student'] {
        --accent: var(--student);
      }
      .card[data-category='sport'] {
        --accent: var(--sport);
      }
      .card[data-tandem-category='videographer'] {
        --accent: var(--videographer);
      }

      .card-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
      }

      .card-label {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .card-rate {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--ink-soft);
      }

      .card-controls {
        display: grid;
        grid-template-columns: 64px 1fr 64px;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
      }

      .stepper {
        appearance: none;
        border: none;
        border-radius: 12px;
        width: 100%;
        height: 56px;
        font-size: 28px;
        line-height: 1;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        color: #fff;
        background: var(--accent);
        cursor: pointer;
        touch-action: manipulation;
        transition: transform 0.08s ease, filter 0.08s ease;
      }

      .stepper--minus {
        background: transparent;
        color: var(--accent);
        border: 2px solid var(--accent);
      }

      .stepper:active {
        transform: scale(0.93);
        filter: brightness(0.95);
      }

      .stepper:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 2px;
      }

      .card-count {
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 40px;
        font-variant-numeric: tabular-nums;
        transition: transform 0.12s ease;
      }

      .card-count.bump {
        transform: scale(1.18);
      }

      .card-subtotal {
        margin-top: 8px;
        text-align: right;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: var(--ink-soft);
      }

      /* ---- History ---- */

      .history {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }

      .history-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        border: none;
        padding: 14px 16px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 15px;
        color: var(--ink);
        cursor: pointer;
      }

      .history-toggle-icon {
        transition: transform 0.15s ease;
        font-size: 20px;
        color: var(--ink-soft);
      }

      .history-toggle[aria-expanded='true'] .history-toggle-icon {
        transform: rotate(90deg);
      }

      .history-panel {
        border-top: 1px solid var(--line);
        padding: 4px 0 8px;
      }

      .history-tabs {
        display: flex;
        gap: 6px;
        padding: 10px 16px 6px;
      }

      .history-tab {
        appearance: none;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 12.5px;
        padding: 6px 12px;
        border-radius: 999px;
        cursor: pointer;
      }

      .history-tab[aria-selected='true'] {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--canvas);
      }

      /*
       * :global() throughout this block because the Week/Month tables are
       * rendered by AggregateTable.astro / TandemAggregateTable.astro,
       * separate components with their own Astro CSS scope — plain class
       * selectors here would only ever match the Day table, which lives
       * directly in this file.
       */
      :global(.history-empty) {
        margin: 0;
        padding: 14px 16px;
        color: var(--ink-soft);
        font-size: 14px;
      }

      :global(.history-scroll) {
        overflow-x: auto;
        padding: 0 8px;
      }

      :global(.history-table) {
        width: 100%;
        border-collapse: collapse;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        white-space: nowrap;
      }

      :global(.history-table th),
      :global(.history-table td) {
        padding: 8px 8px;
        text-align: right;
      }

      :global(.history-table th:first-child),
      :global(.history-table td:first-child) {
        text-align: left;
      }

      :global(.history-table thead th) {
        color: var(--ink-soft);
        font-weight: 600;
        border-bottom: 1px solid var(--line);
      }

      :global(.history-table tbody tr:not(:last-child) td) {
        border-bottom: 1px solid var(--line);
      }

      :global(.th-tandem),
      :global(.td-tandem) {
        color: var(--tandem);
      }
      :global(.th-instructor),
      :global(.td-instructor) {
        color: var(--instructor);
      }
      :global(.th-student),
      :global(.td-student) {
        color: var(--student);
      }
      :global(.th-sport),
      :global(.td-sport) {
        color: var(--sport);
      }
      :global(.th-videographer),
      :global(.td-videographer) {
        color: var(--videographer);
      }

      /* ---- Tandem jump list ---- */

      .tandem-add {
        appearance: none;
        border: none;
        border-radius: 12px;
        width: 100%;
        height: 46px;
        margin-top: 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 14.5px;
        color: #fff;
        background: var(--accent);
        cursor: pointer;
        touch-action: manipulation;
        transition: transform 0.08s ease, filter 0.08s ease;
      }

      .tandem-add:active {
        transform: scale(0.97);
        filter: brightness(0.95);
      }

      .tandem-add:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 2px;
      }

      .tandem-jump-list {
        list-style: none;
        margin: 4px 0 0;
        padding: 0;
      }

      /*
       * :global() here (and below) because the list is re-rendered
       * client-side via innerHTML after each add/delete — Astro only
       * auto-scopes elements it renders itself, not ones a script injects.
       */
      :global(.tandem-jump-row) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 9px 2px;
        border-top: 1px solid var(--line);
        font-size: 13.5px;
      }

      :global(.tandem-jump-name) {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      :global(.tandem-jump-delete) {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        line-height: 1;
        width: 26px;
        height: 26px;
        flex: none;
        border-radius: 8px;
        cursor: pointer;
        touch-action: manipulation;
      }

      :global(.tandem-jump-delete:hover),
      :global(.tandem-jump-delete:focus-visible) {
        background: var(--danger-soft);
        color: var(--danger);
        outline: none;
      }

      :global(.tandem-jump-empty) {
        margin: 0;
        padding: 9px 2px;
        border-top: 1px solid var(--line);
        color: var(--ink-soft);
        font-size: 13px;
      }

      /* ---- Customer-name modal ---- */

      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 22, 32, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        z-index: 20;
      }

      .modal-overlay[hidden] {
        display: none;
      }

      .modal {
        width: 100%;
        max-width: 400px;
        background: var(--panel);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 20px;
      }

      .modal-title {
        margin: 0 0 2px;
        font-size: 17px;
        font-weight: 700;
      }

      .modal-subtitle {
        margin: 0 0 14px;
        font-size: 13px;
        color: var(--ink-soft);
      }

      .modal-input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid var(--line-strong);
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        font-size: 16px;
      }

      .modal-input:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 1px;
      }

      .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 14px;
      }

      .modal-cancel,
      .modal-confirm {
        flex: 1;
        appearance: none;
        border: none;
        border-radius: 10px;
        height: 46px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        touch-action: manipulation;
      }

      .modal-cancel {
        background: transparent;
        border: 1px solid var(--line-strong);
        color: var(--ink-soft);
      }

      .modal-confirm {
        background: var(--gold);
        color: #fff;
      }

      .modal-confirm:disabled {
        opacity: 0.6;
        cursor: default;
      }

      /* ---- Invoice settings ---- */

      .invoice-settings-panel {
        padding: 14px 16px 16px;
      }

      .invoice-settings-hint {
        margin: 0 0 14px;
        font-size: 12.5px;
        color: var(--ink-soft);
      }

      .invoice-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ink-soft);
      }

      .invoice-field--narrow {
        max-width: 160px;
      }

      .invoice-field input,
      .invoice-field textarea,
      .invoice-field select {
        width: 100%;
        padding: 9px 12px;
        border-radius: 10px;
        border: 1px solid var(--line-strong);
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 400;
        resize: vertical;
      }

      .invoice-field select {
        height: 40px;
      }

      .invoice-field input:focus-visible,
      .invoice-field textarea:focus-visible,
      .invoice-field select:focus-visible {
        outline: 3px solid var(--gold);
        outline-offset: 1px;
      }

      .invoice-settings-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 4px;
      }

      .invoice-settings-save {
        appearance: none;
        border: none;
        border-radius: 10px;
        height: 42px;
        padding: 0 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 14px;
