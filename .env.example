# Sets a password gate on the whole app. Leave unset for local dev — the
# app works exactly as before with no login screen. Set this in Vercel's
# dashboard (Settings → Environment Variables) to lock down the deployed
# site so only people who know the password can open it.
APP_PASSWORD=

# Named accounts on one shared deployment, for friends who'd rather sign in
# than each stand up their own Vercel project and R2 bucket (see
# src/lib/server/users.ts and scripts/add-user.mjs). Leave unset — and
# leave APP_PASSWORD above unset too — for a single-tenant deployment like
# Aimee's or Mila's. Set this instead of APP_PASSWORD, never alongside it.
AUTH_SECRET=

# Where the app actually stores its ledgers (src/lib/server/storage.ts).
# Leave all four unset for local dev — data/ on disk is used instead, and
# nothing here is required to run `npm run dev`. Set all four together on
# a deployed instance (Vercel project → Settings → Environment Variables);
# a deployed instance with none of them set refuses to run rather than
# silently using its own ephemeral, per-invocation filesystem as if it
# were real storage.
#
# Cloudflare → R2 → Overview (account id), and R2 → API → Create API
# token, Object Read & Write, scoped to the one bucket below.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dev/testing only — points the app at a local S3-compatible stub instead
# of real R2. Leave unset everywhere else.
R2_ENDPOINT=
